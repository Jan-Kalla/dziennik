<Window x:Class="GradebookApp.ClassDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GradebookApp"
        Title="Szczegóły klasy" Height="720" Width="1080"
        Background="#1E1E1E" Foreground="#E0E0E0">
    <!-- ... Reszta kodu okna bez zmian ... -->
    <Grid Margin="10">
        <Grid x:Name="ClassDetailsView" Visibility="Visible">
            <local:ClassDetailsControl x:Name="WindowClassControl" />
        </Grid>

        <Grid x:Name="StudentDetailsView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <Button Content="← Powrót do klasy" Width="130" Height="30" Margin="0,0,0,10" HorizontalAlignment="Left" Click="BackToClassFromStudent_Click" />
            
            <local:StudentDetailsControl x:Name="WindowStudentControl" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>