<Window x:Class="GradebookApp.PdfViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Podgląd dokumentu PDF" 
        Height="800" Width="1050" 
        MinHeight="450" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="#181818" Foreground="#E0E0E0"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="ViewerBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4DB6AC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1E1E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentViewerBtnStyle" TargetType="Button" BasedOn="{StaticResource ViewerBtnStyle}">
            <Setter Property="Background" Value="#1E382B"/>
            <Setter Property="Foreground" Value="#81C784"/>
            <Setter Property="BorderBrush" Value="#2E5A3E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E5A3E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#81C784"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#162E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Górny pasek narzędzi i tytułu -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Lewa strona: Ikona i Tytuł dokumentu -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📄" FontSize="18" Foreground="#4DB6AC" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock x:Name="FileNameTextBlock" Text="Dokument PDF" FontSize="15" FontWeight="SemiBold" Foreground="#4DB6AC" TextTrimming="CharacterEllipsis" MaxWidth="550" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock x:Name="FilePathTextBlock" Text="Ścieżka pliku" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis" MaxWidth="550" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Prawa strona: Przyciski akcji -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🖨 Drukuj" Style="{StaticResource AccentViewerBtnStyle}" Click="Print_Click" ToolTip="Drukuj dokument (Ctrl + P)"/>
                    <Button x:Name="FullscreenBtn" Content="⛶ Pełny ekran" Style="{StaticResource ViewerBtnStyle}" Click="ToggleFullscreen_Click" ToolTip="Tryb pełnoekranowy (F11)"/>
                    <Button Content="↗ Otwórz w systemie" Style="{StaticResource ViewerBtnStyle}" Click="OpenExternal_Click" ToolTip="Otwórz plik w zewnętrznej domyślnej przeglądarce systemu"/>
                    <Button Content="✕ Zamknij" Style="{StaticResource ViewerBtnStyle}" Click="Close_Click" ToolTip="Zamknij okno podglądu (Esc)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Wskaźnik ładowania dokumentu -->
        <ProgressBar Grid.Row="1" x:Name="LoadingProgressBar" Height="3" IsIndeterminate="True" Foreground="#4DB6AC" Background="#1E1E1E" BorderThickness="0"/>

        <!-- Główny obszar przeglądarki PDF (WebView2) -->
        <Grid Grid.Row="2">
            <wv2:WebView2 x:Name="PdfWebView" NavigationCompleted="PdfWebView_NavigationCompleted"/>

            <!-- Panel błędu, jeśli plik nie został znaleziony -->
            <Border x:Name="ErrorPanel" Background="#1E1E1E" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30" CornerRadius="8" BorderBrush="#C62828" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⚠️ Nie można załadować pliku PDF" FontSize="18" FontWeight="Bold" Foreground="#EF5350" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ErrorMessageTextBlock" Text="Plik nie istnieje lub wystąpił problem z dostępem." FontSize="13" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Spróbuj ponownie" Style="{StaticResource ViewerBtnStyle}" Click="Retry_Click"/>
                        <Button Content="Otwórz w systemie" Style="{StaticResource ViewerBtnStyle}" Click="OpenExternal_Click"/>
                        <Button Content="Zamknij" Style="{StaticResource ViewerBtnStyle}" Click="Close_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
