<Window x:Class="GradebookApp.PlanRetakeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zaplanuj poprawę" Width="700" Height="620" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="#E0E0E0">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- NOWA SEKCJA: WYBÓR KLASY -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15" x:Name="ClassSelectionPanel">
            <TextBlock Text="Wybierz klasę:" Margin="0,0,0,5" FontSize="14" FontWeight="Bold" Foreground="#4DB6AC"/>
            <ComboBox x:Name="ClassComboBox" DisplayMemberPath="Name" Height="28" FontSize="14" SelectionChanged="ClassComboBox_SelectionChanged"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="Wybierz pracę pisemną do poprawy:" Margin="0,0,0,5" FontSize="14"/>
                <ComboBox x:Name="WorkComboBox" DisplayMemberPath="Title" Height="28" FontSize="14"/>
            </StackPanel>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Data:" Margin="0,0,0,5" FontSize="14"/>
                    <DatePicker x:Name="DatePicker" Width="120" Height="28" FontSize="14"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Godzina:" Margin="0,0,0,5" FontSize="14"/>
                    <TextBox x:Name="TimeTextBox" Width="70" Height="28" FontSize="14" VerticalContentAlignment="Center" MaxLength="5"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="Wybierz uczniów klikając w nich na liście:" FontWeight="Bold" Margin="0,0,0,10" FontSize="14"/>
        
        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="SearchTextBox" Height="28" Margin="0,0,0,5" FontSize="14" VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Szukaj ucznia z klasy..." Foreground="#888888" FontStyle="Italic"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                
                <ListBox x:Name="AvailableStudentsList" Grid.Row="1" DisplayMemberPath="FullName" FontSize="14">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="5,8"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="ToolTip" Value="Kliknij, aby dodać do poprawy"/>
                            <EventSetter Event="MouseLeftButtonUp" Handler="AvailableStudent_Click" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
            
            <TextBlock Grid.Column="1" Text="➔" FontSize="28" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#252526" BorderBrush="#434346" BorderThickness="1" Height="28" Margin="0,0,0,5">
                    <TextBlock Text="Wybrani do pisania (kliknij, by usunąć):" FontSize="13" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </Border>
                <ListBox x:Name="SelectedStudentsList" Grid.Row="1" DisplayMemberPath="FullName" FontSize="14" Background="#1E2E1E" BorderBrush="#4CAF50" BorderThickness="1">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="5,8"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="ToolTip" Value="Kliknij, aby usunąć z listy"/>
                            <EventSetter Event="MouseLeftButtonUp" Handler="SelectedStudent_Click" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Grid>
        
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Anuluj" Width="80" Height="30" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Zapisz" Width="100" Height="30" Click="Save_Click" IsDefault="True" Background="#007ACC" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>