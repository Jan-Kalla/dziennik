<Window x:Class="GradebookApp.WorkEditConflictsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rozwiąż konflikty ocen" Width="650" Height="450" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="#E0E0E0">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Uwaga - praca została już oceniona!" FontSize="20" FontWeight="Bold" Foreground="#E57373" Margin="0,0,0,10" Grid.Row="0"/>
        <TextBlock Text="Zmieniono punktację zadań, w których niektórzy uczniowie posiadają już wpisane oceny. Dostosuj ich punkty do nowych wartości przed zapisaniem zmian w całej pracy." TextWrapping="Wrap" Margin="0,0,0,15" FontSize="14" Foreground="#B0BEC5" Grid.Row="1"/>

        <DataGrid x:Name="ConflictsDataGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="Cell" Margin="0,0,0,15" Background="#252526" Foreground="#E0E0E0" BorderBrush="#434346" RowBackground="#2D2D30" AlternatingRowBackground="#252526" HeadersVisibility="Column" FontSize="14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Uczeń" Binding="{Binding StudentName}" IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="Miejsce konfliktu" Binding="{Binding TaskInfo}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Stary Max" Binding="{Binding OldMax}" IsReadOnly="True" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Nowy Max" Binding="{Binding NewMax}" IsReadOnly="True" Width="85">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Foreground" Value="#4DB6AC"/><Setter Property="FontWeight" Value="Bold"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                <!-- Edytowalne pole na wpisanie nowych punktów -->
                <DataGridTextColumn Header="Nowe punkty" Binding="{Binding NewPoints, UpdateSourceTrigger=PropertyChanged}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#FFB74D"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Anuluj" Width="100" Height="30" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Zapisz poprawki i kontynuuj" Width="200" Height="30" Click="Save_Click" Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>