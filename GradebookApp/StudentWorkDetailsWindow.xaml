<Window Background="#1E1E1E" Foreground="#E0E0E0" ResizeMode="NoResize" SizeToContent="Height" Title="Ocenianie ucznia" Width="1050" WindowStartupLocation="CenterOwner" x:Class="GradebookApp.StudentWorkDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#252526" BorderBrush="#434346" BorderThickness="1" CornerRadius="5" Grid.Row="0" Margin="0,0,0,15" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="18" FontWeight="Bold" Margin="0,0,0,10" x:Name="WorkTypeAndTitleText"/>
                    <TextBlock FontSize="14" Margin="0,0,0,5" x:Name="ClassGroupText"/>
                    <TextBlock FontSize="14" Foreground="#AAAAAA" Margin="0,0,0,5" x:Name="DatesText"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock FontSize="14" Foreground="#AAAAAA" HorizontalAlignment="Right" Text="Wynik końcowy:"/>
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="#4DB6AC" HorizontalAlignment="Right" x:Name="TotalResultText"/>
                    <TextBlock FontSize="16" Foreground="#888888" HorizontalAlignment="Right" x:Name="PercentageResultText"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#2D2D30" BorderBrush="#434346" BorderThickness="1" CornerRadius="5" Grid.Column="0" Padding="10">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock FontWeight="Bold" Foreground="#CCCCCC" Text="TERMIN BAZOWY" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BasePanelScoreText" Foreground="#AAAAAA" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0" Margin="0,0,10,10" Text="Grupa:" VerticalAlignment="Center"/>
                        
                        <!-- INTELIGENTNY PANEL Z WYBOREM SPOSOBU WPISYWANIA GRUPY -->
                        <Grid Grid.Column="1" Grid.Row="0" Margin="0,0,0,10" HorizontalAlignment="Left">
                            <TextBox x:Name="GroupTextBox" Height="24" Width="60" Visibility="Visible" VerticalContentAlignment="Center"/>
                            <ComboBox x:Name="GroupComboBox" Height="24" Width="60" Visibility="Collapsed" SelectionChanged="GroupComboBox_SelectionChanged"/>
                        </Grid>

                        <TextBlock Grid.Column="0" Grid.Row="1" Margin="0,0,10,0" Text="Indyw. daty (Napis. / Wpis.):" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal">
                            <DatePicker Height="24" Margin="0,0,5,0" Width="105" x:Name="CustomDateWrittenPicker"/>
                            <DatePicker Height="24" SelectedDateChanged="CustomDateEnteredPicker_SelectedDateChanged" Width="105" x:Name="CustomDateEnteredPicker"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox Checked="AbsentCheckBox_Changed" Content="Uczeń nieobecny (NB)" FontWeight="Bold" Foreground="#E57373" Margin="0,10,0,0" Unchecked="AbsentCheckBox_Changed" x:Name="AbsentCheckBox"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="RetakePromptPanel">
                <TextBlock FontWeight="Bold" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,0,0,10" Text="Termin na poprawę: --" x:Name="RetakeDeadlinePromptText"/>
                <Button Click="ActivateRetakeButton_Click" Content="Dodaj poprawę" Height="30" Width="120"/>
            </StackPanel>

            <Border Background="#1E2E1E" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="5" Grid.Column="2" Padding="10" Visibility="Collapsed" x:Name="RetakeEditPanel">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock FontWeight="Bold" Foreground="#81C784" Text="POPRAWA" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="RetakePanelScoreText" Foreground="#81C784" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <Button Background="Transparent" BorderThickness="0" Click="DeactivateRetakeButton_Click" Content="Usuń poprawę" Cursor="Hand" Foreground="#E57373" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0" Margin="0,0,10,10" Text="Grupa:" VerticalAlignment="Center"/>
                        
                        <!-- INTELIGENTNY PANEL DLA GRUPY POPRAWY -->
                        <Grid Grid.Column="1" Grid.Row="0" Margin="0,0,0,10" HorizontalAlignment="Left">
                            <TextBox x:Name="RetakeGroupTextBox" Height="24" Width="60" Visibility="Visible" VerticalContentAlignment="Center"/>
                            <ComboBox x:Name="RetakeGroupComboBox" Height="24" Width="60" Visibility="Collapsed" SelectionChanged="RetakeGroupComboBox_SelectionChanged"/>
                        </Grid>

                        <TextBlock Grid.Column="0" Grid.Row="1" Margin="0,0,10,10" Text="Zmieniony termin (do):" VerticalAlignment="Center"/>
                        <DatePicker Grid.Column="1" Grid.Row="1" Height="24" HorizontalAlignment="Left" Margin="0,0,0,10" Width="110" x:Name="RetakeDeadlinePicker"/>

                        <TextBlock Grid.Column="0" Grid.Row="2" Margin="0,0,10,0" Text="Daty (Napis. / Wpis.):" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal">
                            <DatePicker Height="24" Margin="0,0,5,0" Width="105" x:Name="RetakeDateWrittenPicker"/>
                            <DatePicker Height="24" Width="105" x:Name="RetakeDateEnteredPicker"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,15" Visibility="Collapsed" x:Name="ActivityScorePanel">
            <TextBlock FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,0,0,5" Text="Wpisz zdobyte punkty:"/>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBox FontSize="18" Height="30" HorizontalContentAlignment="Center" TextChanged="ActivityScoreTextBox_TextChanged" VerticalContentAlignment="Center" Width="80" x:Name="ActivityScoreTextBox"/>
                <TextBlock FontSize="18" Foreground="#AAAAAA" Margin="10,0,0,0" Text="/ 5 pkt" VerticalAlignment="Center" x:Name="ActivityMaxPointsText"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,15" x:Name="ScoreControlsPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Button Click="ToggleDetailsButton_Click" Content="Pokaż / Edytuj szczegóły punktacji ↓" Grid.Column="0" Height="30" x:Name="ToggleDetailsButton"/>
            <Button Click="FillMaxPoints_Click" Content="100% (Max pkt)" Grid.Column="2" Height="30" Background="#2E4A2E" BorderBrush="#4CAF50" Cursor="Hand" x:Name="FillMaxPointsButton"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,15" Visibility="Collapsed" x:Name="DetailsGrid">
            <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" FontSize="14" MaxHeight="350" SelectionUnit="Cell" x:Name="ScoresDataGrid">
                <DataGrid.Resources>
                    <Style TargetType="TextBox">
                        <EventSetter Event="PreviewKeyDown" Handler="ScoreTextBox_PreviewKeyDown"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#E0E0E0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.InputBindings>
                    <KeyBinding Command="ApplicationCommands.NotACommand" Key="Return"/>
                </DataGrid.InputBindings>
                <DataGrid.CellStyle>
                    <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="DataGridCell">
                        <EventSetter Event="GotFocus" Handler="DataGridCell_GotFocus"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding TaskNumber}" Header="Zad." IsReadOnly="True" Width="40">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="IsTabStop" Value="False"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTemplateColumn Header="BAZA: Poz I" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><StackPanel Margin="5,0,0,0" Orientation="Horizontal"><TextBox Margin="0,0,5,0" Text="{Binding ScoreL1, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" Width="40"/><TextBlock Foreground="#AAAAAA" Text="{Binding MaxL1, StringFormat=/ {0}}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="BAZA: Poz II" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><StackPanel Margin="5,0,0,0" Orientation="Horizontal"><TextBox Margin="0,0,5,0" Text="{Binding ScoreL2, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" Width="40"/><TextBlock Foreground="#AAAAAA" Text="{Binding MaxL2, StringFormat=/ {0}}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="BAZA: Poz III" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><StackPanel Margin="5,0,0,0" Orientation="Horizontal"><TextBox Margin="0,0,5,0" Text="{Binding ScoreL3, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" Width="40"/><TextBlock Foreground="#AAAAAA" Text="{Binding MaxL3, StringFormat=/ {0}}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn Header="POPRAWA: Poz I" Visibility="Collapsed" Width="*" x:Name="RetakeCol1">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><Border Background="#1E2E1E" Padding="5,0,0,0"><StackPanel Orientation="Horizontal"><TextBox Margin="0,0,5,0" Text="{Binding RetakeScoreL1, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" Width="40"/><TextBlock Foreground="#81C784" Text="{Binding MaxL1, StringFormat=/ {0}}" VerticalAlignment="Center"/></StackPanel></Border></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="POPRAWA: Poz II" Visibility="Collapsed" Width="*" x:Name="RetakeCol2">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><Border Background="#1E2E1E" Padding="5,0,0,0"><StackPanel Orientation="Horizontal"><TextBox Margin="0,0,5,0" Text="{Binding RetakeScoreL2, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" Width="40"/><TextBlock Foreground="#81C784" Text="{Binding MaxL2, StringFormat=/ {0}}" VerticalAlignment="Center"/></StackPanel></Border></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="POPRAWA: Poz III" Visibility="Collapsed" Width="*" x:Name="RetakeCol3">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><Border Background="#1E2E1E" Padding="5,0,0,0"><StackPanel Orientation="Horizontal"><TextBox Margin="0,0,5,0" Text="{Binding RetakeScoreL3, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" Width="40"/><TextBlock Foreground="#81C784" Text="{Binding MaxL3, StringFormat=/ {0}}" VerticalAlignment="Center"/></StackPanel></Border></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="5" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Click="Cancel_Click" Content="Anuluj" Height="30" Margin="0,0,10,0" Width="80"/>
            <Button Background="#007ACC" BorderThickness="0" Click="Save_Click" Content="Zapisz zmiany" Foreground="White" Height="30" IsDefault="True" Width="120"/>
        </StackPanel>
    </Grid>
</Window>