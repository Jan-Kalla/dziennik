<Window x:Class="GradebookApp.StudentWorkDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ocenianie pracy ucznia" Width="1050" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="#E0E0E0">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#434346" BorderThickness="1" CornerRadius="5" Padding="15" Background="#252526" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="WorkTypeAndTitleText" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ClassGroupText" FontSize="14" Margin="0,0,0,5"/>
                    <TextBlock x:Name="DatesText" FontSize="14" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Wynik końcowy:" FontSize="14" Foreground="#AAAAAA" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TotalResultText" FontSize="22" FontWeight="Bold" Foreground="#4DB6AC" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#434346" BorderThickness="1" CornerRadius="5" Padding="10" Background="#2D2D30">
                <StackPanel>
                    <TextBlock Text="TERMIN BAZOWY" FontWeight="Bold" Margin="0,0,0,10" Foreground="#CCCCCC"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Grupa:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <TextBox x:Name="GroupTextBox" Grid.Row="0" Grid.Column="1" Width="50" Height="24" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Indyw. daty (Napis. / Wpis.):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <DatePicker x:Name="CustomDateWrittenPicker" Width="105" Height="24" Margin="0,0,5,0"/>
                            <DatePicker x:Name="CustomDateEnteredPicker" Width="105" Height="24" SelectedDateChanged="CustomDateEnteredPicker_SelectedDateChanged"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="AbsentCheckBox" Content="Uczeń nieobecny (NB)" FontWeight="Bold" Foreground="#E57373" 
                              Margin="0,10,0,0" Checked="AbsentCheckBox_Changed" Unchecked="AbsentCheckBox_Changed"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="RetakePromptPanel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="RetakeDeadlinePromptText" Text="Termin na poprawę: --" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                <Button Content="Dodaj poprawę" Width="120" Height="30" Click="ActivateRetakeButton_Click"/>
            </StackPanel>

            <Border x:Name="RetakeEditPanel" Grid.Column="2" Visibility="Collapsed" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="5" Padding="10" Background="#1E2E1E">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="POPRAWA" FontWeight="Bold" Foreground="#81C784" VerticalAlignment="Center"/>
                        <Button Content="Usuń poprawę" Foreground="#E57373" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand" Click="DeactivateRetakeButton_Click"/>
                    </Grid>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Zmieniony termin (do):" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <DatePicker x:Name="RetakeDeadlinePicker" Grid.Row="0" Grid.Column="1" Width="110" Height="24" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Daty (Napis. / Wpis.):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <DatePicker x:Name="RetakeDateWrittenPicker" Width="105" Height="24" Margin="0,0,5,0"/>
                            <DatePicker x:Name="RetakeDateEnteredPicker" Width="105" Height="24"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Button x:Name="ToggleDetailsButton" Grid.Row="2" Content="Pokaż / Edytuj szczegóły punktacji ↓" Height="30" Margin="0,0,0,15" Click="ToggleDetailsButton_Click"/>

        <Grid x:Name="DetailsGrid" Grid.Row="3" Visibility="Collapsed" Margin="0,0,0,15">
            <DataGrid x:Name="ScoresDataGrid" FontSize="14" MaxHeight="350"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="Cell">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Zad." Binding="{Binding TaskNumber}" IsReadOnly="True" Width="40"/>
                    
                    <DataGridTemplateColumn Header="BAZA: Poz I" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><StackPanel Orientation="Horizontal" Margin="5,0,0,0"><TextBox Text="{Binding ScoreL1, UpdateSourceTrigger=LostFocus}" Width="40" Margin="0,0,5,0" VerticalContentAlignment="Center"/><TextBlock Text="{Binding MaxL1, StringFormat=/ {0}}" Foreground="#AAAAAA" VerticalAlignment="Center" /></StackPanel></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="BAZA: Poz II" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><StackPanel Orientation="Horizontal" Margin="5,0,0,0"><TextBox Text="{Binding ScoreL2, UpdateSourceTrigger=LostFocus}" Width="40" Margin="0,0,5,0" VerticalContentAlignment="Center"/><TextBlock Text="{Binding MaxL2, StringFormat=/ {0}}" Foreground="#AAAAAA" VerticalAlignment="Center" /></StackPanel></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="BAZA: Poz III" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><StackPanel Orientation="Horizontal" Margin="5,0,0,0"><TextBox Text="{Binding ScoreL3, UpdateSourceTrigger=LostFocus}" Width="40" Margin="0,0,5,0" VerticalContentAlignment="Center"/><TextBlock Text="{Binding MaxL3, StringFormat=/ {0}}" Foreground="#AAAAAA" VerticalAlignment="Center" /></StackPanel></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn x:Name="RetakeCol1" Header="POPRAWA: Poz I" Width="*" Visibility="Collapsed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><Border Background="#1E2E1E" Padding="5,0,0,0"><StackPanel Orientation="Horizontal"><TextBox Text="{Binding RetakeScoreL1, UpdateSourceTrigger=LostFocus}" Width="40" Margin="0,0,5,0" VerticalContentAlignment="Center"/><TextBlock Text="{Binding MaxL1, StringFormat=/ {0}}" Foreground="#81C784" VerticalAlignment="Center" /></StackPanel></Border></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="RetakeCol2" Header="POPRAWA: Poz II" Width="*" Visibility="Collapsed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><Border Background="#1E2E1E" Padding="5,0,0,0"><StackPanel Orientation="Horizontal"><TextBox Text="{Binding RetakeScoreL2, UpdateSourceTrigger=LostFocus}" Width="40" Margin="0,0,5,0" VerticalContentAlignment="Center"/><TextBlock Text="{Binding MaxL2, StringFormat=/ {0}}" Foreground="#81C784" VerticalAlignment="Center" /></StackPanel></Border></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="RetakeCol3" Header="POPRAWA: Poz III" Width="*" Visibility="Collapsed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><Border Background="#1E2E1E" Padding="5,0,0,0"><StackPanel Orientation="Horizontal"><TextBox Text="{Binding RetakeScoreL3, UpdateSourceTrigger=LostFocus}" Width="40" Margin="0,0,5,0" VerticalContentAlignment="Center"/><TextBlock Text="{Binding MaxL3, StringFormat=/ {0}}" Foreground="#81C784" VerticalAlignment="Center" /></StackPanel></Border></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Anuluj" Width="80" Height="30" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Zapisz zmiany" Width="120" Height="30" Click="Save_Click" IsDefault="True" Background="#007ACC" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>