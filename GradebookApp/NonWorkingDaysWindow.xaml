<Window x:Class="GradebookApp.NonWorkingDaysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalendarz dni wolnych i roku szkolnego" Height="840" Width="1340" MinWidth="1240" 
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" Foreground="#E0E0E0">

    <Window.Resources>
        <!-- Zapewnienie ciemnego tła systemowego dla Popupów (np. DatePicker drop-down) -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#252526" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFF" />

        <!-- Wyraźny, czytelny styl dla pól daty: biały tekst na ciemnym tle -->
        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
        </Style>
        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#434346"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CalendarStyle" Value="{StaticResource DarkCalendarStyle}"/>
        </Style>
        <Style TargetType="{x:Type Calendar}" BasedOn="{StaticResource DarkCalendarStyle}"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Nagłówek i nawigacja roku szkolnego -->
            <RowDefinition Height="*"/>    <!-- Główna zawartość (Kalendarz po lewej, Panel reguł po prawej) -->
            <RowDefinition Height="Auto"/> <!-- Stopka ze statystykami i przyciskami -->
        </Grid.RowDefinitions>

        <!-- 1. NAGŁÓWEK ROKU SZKOLNEGO -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="15,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrevSchoolYearButton" Content="◀ Poprzedni rok" Click="PrevSchoolYear_Click" 
                            Background="#333337" Foreground="#E0E0E0" BorderThickness="0" Padding="10,6" Cursor="Hand" Margin="0,0,10,0"/>
                    <TextBlock x:Name="SchoolYearTitleText" Text="ROK SZKOLNY 2026 / 2027" FontSize="18" FontWeight="Bold" 
                               Foreground="#FFB74D" VerticalAlignment="Center" Margin="5,0"/>
                    <Button x:Name="NextSchoolYearButton" Content="Następny rok ▶" Click="NextSchoolYear_Click" 
                            Background="#333337" Foreground="#E0E0E0" BorderThickness="0" Padding="10,6" Cursor="Hand" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0">
                    <TextBlock x:Name="StatsSummaryText" Text="Dni nauki (Wrz - Cze): Robocze: 0 | Wolne: 0" FontSize="13" FontWeight="SemiBold" Foreground="#B0BEC5"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🇵🇱 Wstaw polskie święta państwowe" Click="SeedHolidays_Click" 
                            Background="#2E4A2E" Foreground="#E0E0E0" BorderThickness="0" Padding="14,6" Cursor="Hand" FontWeight="SemiBold"
                            ToolTip="Dodaje coroczne polskie święta (Nowy Rok, Trzech Króli, 1 i 3 Maja, 15 Sierpnia, 1 i 11 Listopada, Boże Narodzenie)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. GŁÓWNA ZAWARTOŚĆ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/> <!-- Lewa kolumna: Kalendarz -->
                <ColumnDefinition Width="2*"/> <!-- Prawa kolumna: Formularz i reguły -->
            </Grid.ColumnDefinitions>

            <!-- LEWA KOLUMNA: KALENDARZ MIESIĘCZNY -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Przyciski miesięcy roku szkolnego (10 miesięcy: Wrzesień -> Czerwiec) -->
                        <RowDefinition Height="Auto"/> <!-- Nagłówek wybranego miesiąca z nawigacją -->
                        <RowDefinition Height="Auto"/> <!-- Dni tygodnia (Pn-Nd) -->
                        <RowDefinition Height="*"/>    <!-- Siatka dni miesiąca -->
                        <RowDefinition Height="Auto"/> <!-- Legenda kolorów -->
                    </Grid.RowDefinitions>

                    <!-- Pasek 10 miesięcy roku szkolnego (Wrzesień -> Czerwiec, bez wakacyjnych lipca i sierpnia) -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,10" HorizontalAlignment="Center">
                        <Button x:Name="BtnMonth9" Content="Wrz" Tag="9" Click="MonthTab_Click" Margin="2" Padding="10,5" Background="#333337" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="BtnMonth10" Content="Paź" Tag="10" Click="MonthTab_Click" Margin="2" Padding="10,5" Background="#333337" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="BtnMonth11" Content="Lis" Tag="11" Click="MonthTab_Click" Margin="2" Padding="10,5" Background="#333337" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="BtnMonth12" Content="Gru" Tag="12" Click="MonthTab_Click" Margin="2" Padding="10,5" Background="#333337" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="BtnMonth1" Content="Sty" Tag="1" Click="MonthTab_Click" Margin="2" Padding="10,5" Background="#333337" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="BtnMonth2" Content="Lut" Tag="2" Click="MonthTab_Click" Margin="2" Padding="10,5" Background="#333337" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="BtnMonth3" Content="Mar" Tag="3" Click="MonthTab_Click" Margin="2" Padding="10,5" Background="#333337" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="BtnMonth4" Content="Kwi" Tag="4" Click="MonthTab_Click" Margin="2" Padding="10,5" Background="#333337" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="BtnMonth5" Content="Maj" Tag="5" Click="MonthTab_Click" Margin="2" Padding="10,5" Background="#333337" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="BtnMonth6" Content="Cze" Tag="6" Click="MonthTab_Click" Margin="2" Padding="10,5" Background="#333337" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </WrapPanel>

                    <!-- Nagłówek aktualnego miesiąca -->
                    <Border Grid.Row="1" Background="#2D2D30" Padding="10,6" CornerRadius="3" Margin="0,0,0,6">
                        <Grid>
                            <Button Content="◀ Poprzedni miesiąc" Click="PrevMonth_Click" HorizontalAlignment="Left" Background="Transparent" Foreground="#E0E0E0" BorderThickness="0" Cursor="Hand" Padding="8,2" FontSize="13"/>
                            <TextBlock x:Name="CurrentMonthTitleText" Text="Październik 2026" FontSize="16" FontWeight="Bold" Foreground="#4FC3F7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="Następny miesiąc ▶" Click="NextMonth_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="#E0E0E0" BorderThickness="0" Cursor="Hand" Padding="8,2" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- Nagłówki dni tygodnia -->
                    <UniformGrid Grid.Row="2" Columns="7" Margin="0,4,0,4">
                        <TextBlock Text="Pn" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#9E9E9E"/>
                        <TextBlock Text="Wt" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#9E9E9E"/>
                        <TextBlock Text="Śr" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#9E9E9E"/>
                        <TextBlock Text="Cz" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#9E9E9E"/>
                        <TextBlock Text="Pt" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#9E9E9E"/>
                        <TextBlock Text="Sb" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#E57373"/>
                        <TextBlock Text="Nd" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#E57373"/>
                    </UniformGrid>

                    <!-- Siatka 42 kafelków dni miesiąca -->
                    <UniformGrid x:Name="DaysUniformGrid" Grid.Row="3" Columns="7" Rows="6" Margin="0,2"/>

                    <!-- Legenda pod kalendarzem -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Border Width="14" Height="14" Background="#2D2D30" BorderBrush="#434346" BorderThickness="1" Margin="0,0,6,0"/>
                        <TextBlock Text="Dzień roboczy" FontSize="12" Foreground="#B0BEC5" Margin="0,0,15,0" VerticalAlignment="Center"/>

                        <Border Width="14" Height="14" Background="#5A1A1A" BorderBrush="#E57373" BorderThickness="1" Margin="0,0,6,0"/>
                        <TextBlock Text="Dzień wolny / Święto / Okres" FontSize="12" Foreground="#B0BEC5" Margin="0,0,15,0" VerticalAlignment="Center"/>

                        <Border Width="14" Height="14" Background="#1A4B66" BorderBrush="#00E5FF" BorderThickness="1.5" Margin="0,0,6,0"/>
                        <TextBlock Text="Zaznaczony wybór (Od - Do)" FontSize="12" Foreground="#4FC3F7" Margin="0,0,15,0" VerticalAlignment="Center"/>

                        <Border Width="14" Height="14" Background="#3A2E1A" BorderBrush="#FFB74D" BorderThickness="1" Margin="0,0,6,0"/>
                        <TextBlock Text="Dzisiaj" FontSize="12" Foreground="#B0BEC5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PRAWA KOLUMNA: ZARZĄDZANIE REGUŁAMI I DNIAMI WOLNYMI -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Stałe dni tygodnia -->
                    <RowDefinition Height="Auto"/> <!-- Formularz dodawania wolnego dnia/okresu -->
                    <RowDefinition Height="*"/>    <!-- Lista aktywnych reguł -->
                </Grid.RowDefinitions>

                <!-- SEKCJA: STAŁE DNI TYGODNIA (NP. WOLNE PIĄTKI) -->
                <Border Grid.Row="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Stałe dni tygodnia wyłączone z pracy:" FontWeight="Bold" FontSize="14" Foreground="#FFB74D" Margin="0,0,0,6"/>
                        <TextBlock Text="Zaznacz dni tygodnia, w które nie prowadzisz zajęć (np. każdy piątek):" FontSize="11" Foreground="#9E9E9E" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        
                        <WrapPanel>
                            <CheckBox x:Name="MondayCheckBox" Content="Pon" Margin="0,0,12,4" Click="WeeklyDay_Changed" Foreground="#E0E0E0"/>
                            <CheckBox x:Name="TuesdayCheckBox" Content="Wt" Margin="0,0,12,4" Click="WeeklyDay_Changed" Foreground="#E0E0E0"/>
                            <CheckBox x:Name="WednesdayCheckBox" Content="Śr" Margin="0,0,12,4" Click="WeeklyDay_Changed" Foreground="#E0E0E0"/>
                            <CheckBox x:Name="ThursdayCheckBox" Content="Czw" Margin="0,0,12,4" Click="WeeklyDay_Changed" Foreground="#E0E0E0"/>
                            <CheckBox x:Name="FridayCheckBox" Content="Pt" Margin="0,0,12,4" Click="WeeklyDay_Changed" Foreground="#E0E0E0"/>
                            <CheckBox x:Name="SaturdayCheckBox" Content="Sob (weekend)" IsChecked="True" IsEnabled="False" Margin="0,0,12,4" Foreground="#B0BEC5"/>
                            <CheckBox x:Name="SundayCheckBox" Content="Nie (weekend)" IsChecked="True" IsEnabled="False" Margin="0,0,12,4" Foreground="#B0BEC5"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- SEKCJA: FORMULARZ DODAWANIA NOWEGO DNIA LUB OKRESU -->
                <Border Grid.Row="1" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Dodaj dzień wolny lub okres:" FontWeight="Bold" FontSize="14" Foreground="#4DB6AC" Margin="0,0,0,8"/>

                        <!-- Wybór typu reguły -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="SingleDayRadio" Content="Pojedynczy dzień" IsChecked="True" GroupName="RuleTypeGroup" Checked="RuleType_Changed" Margin="0,0,12,0" Foreground="#E0E0E0"/>
                            <RadioButton x:Name="DateRangeRadio" Content="Okres (Od - Do)" GroupName="RuleTypeGroup" Checked="RuleType_Changed" Margin="0,0,12,0" Foreground="#E0E0E0"/>
                            <RadioButton x:Name="RecurringRadio" Content="Dzień co roku" GroupName="RuleTypeGroup" Checked="RuleType_Changed" Foreground="#E0E0E0"/>
                        </StackPanel>

                        <!-- Nazwa reguły -->
                        <TextBlock Text="Nazwa / Powód wolnego:" FontSize="12" Foreground="#B0BEC5" Margin="0,0,0,2"/>
                        <TextBox x:Name="RuleNameTextBox" Height="30" Background="#252526" Foreground="White" BorderBrush="#434346" Padding="6,2" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

                        <!-- Panel 1: Pojedynczy dzień -->
                        <StackPanel x:Name="SingleDayPanel" Visibility="Visible" Margin="0,0,0,8">
                            <TextBlock Text="Wybierz datę:" FontSize="12" Foreground="#B0BEC5" Margin="0,0,0,2"/>
                            <DatePicker x:Name="SingleDatePicker" SelectedDateFormat="Short" SelectedDateChanged="SingleDatePicker_SelectedDateChanged" CalendarStyle="{StaticResource DarkCalendarStyle}"/>
                        </StackPanel>

                        <!-- Panel 2: Okres od-do (z opcją powtarzalności co roku!) -->
                        <StackPanel x:Name="DateRangePanel" Visibility="Collapsed" Margin="0,0,0,8">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="💡 Kliknij dzień rozpoczęcia (Od), a następnie dzień zakończenia (Do) na kalendarzu." 
                                           FontSize="11" Foreground="#4FC3F7" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Content="Wyczyść" Click="ClearRangeSelection_Click" HorizontalAlignment="Right"
                                        Background="Transparent" Foreground="#FFB74D" BorderThickness="0" Cursor="Hand" FontSize="11" Margin="6,0,0,0" ToolTip="Resetuj zaznaczony zakres"/>
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Data rozpoczęcia (Od):" FontSize="12" Foreground="#B0BEC5" Margin="0,0,0,2"/>
                                    <DatePicker x:Name="RangeStartDatePicker" SelectedDateChanged="RangeDatePicker_SelectedDateChanged" CalendarStyle="{StaticResource DarkCalendarStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Data zakończenia (Do):" FontSize="12" Foreground="#B0BEC5" Margin="0,0,0,2"/>
                                    <DatePicker x:Name="RangeEndDatePicker" SelectedDateChanged="RangeDatePicker_SelectedDateChanged" CalendarStyle="{StaticResource DarkCalendarStyle}"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- NOWOŚĆ: Powtarzanie okresu co roku -->
                            <CheckBox x:Name="RangeRecurringCheckBox" Content="Powtarzaj ten okres co roku (np. Boże Narodzenie 23.12 - 01.01)" Margin="0,8,0,2" Foreground="#FFD54F" FontWeight="SemiBold"/>
                            <TextBlock Text="Gdy zaznaczone, ten zakres dat będzie obowiązywał we wszystkich kolejnych latach szkolnych." FontSize="11" Foreground="#9E9E9E" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Panel 3: Powtarzalny pojedynczy dzień co roku -->
                        <Grid x:Name="RecurringPanel" Visibility="Collapsed" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Dzień (1-31):" FontSize="12" Foreground="#B0BEC5" Margin="0,0,0,2"/>
                                <TextBox x:Name="RecurringDayTextBox" Width="60" Height="30" Background="#252526" Foreground="White" BorderBrush="#434346" TextAlignment="Center" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Miesiąc:" FontSize="12" Foreground="#B0BEC5" Margin="0,0,0,2"/>
                                <ComboBox x:Name="RecurringMonthComboBox" Height="30" Background="#252526" Foreground="White"/>
                            </StackPanel>
                        </Grid>

                        <!-- Przycisk dodawania -->
                        <Button Content="+ Dodaj regułę do kalendarza" Click="AddRule_Click" Height="34" Background="#2E7D32" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- SEKCJA: LISTA ZDEFINIOWANYCH REGUŁ -->
                <Border Grid.Row="2" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Zdefiniowane reguły dni wolnych:" FontWeight="Bold" FontSize="14" Foreground="#81D4FA" Margin="0,0,0,6"/>

                        <DataGrid x:Name="RulesDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                  IsReadOnly="True" Background="#1E1E1E" RowBackground="#252526" AlternatingRowBackground="#1E1E1E" 
                                  Foreground="#E0E0E0" BorderBrush="#434346" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333337" 
                                  SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Typ" Binding="{Binding TypeDisplay}" Width="120"/>
                                <DataGridTextColumn Header="Termin / Zakres" Binding="{Binding DateDisplay}" Width="170"/>
                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Usuń" Click="DeleteRule_Click" Background="#C62828" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="4,2" Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 3. STOPKA -->
        <Border Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Zamknij" Click="Close_Click" Width="100" Height="32" Background="#333337" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
