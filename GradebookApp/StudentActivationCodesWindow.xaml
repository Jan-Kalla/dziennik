<Window x:Class="GradebookApp.StudentActivationCodesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kody aktywacyjne uczniów (MatApp)" Height="650" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- NAGŁÓWEK -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="📱" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Zarządzanie kodami aktywacyjnymi MatApp" FontSize="16" FontWeight="Bold" Foreground="#00B0FF"/>
                    <TextBlock Text="Generuj unikalne kody dla uczniów do powiązania z ich smartfonami. Wygenerowanie nowego kodu automatycznie unieważnia poprzedni." 
                               FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KONTROLKI WYBORU KLASY I AKCJI -->
        <Border Grid.Row="1" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Wybierz klasę:" VerticalAlignment="Center" Foreground="#E0E0E0" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" x:Name="ClassComboBox" Height="30" VerticalContentAlignment="Center"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="ClassComboBox_SelectionChanged"/>

                <Button Grid.Column="2" Content="Pobierz z bazy ↻" Click="RefreshCodes_Click" Height="30" Padding="12,0" Margin="10,0,0,0"
                        Background="#333337" Foreground="#E0E0E0" BorderBrush="#555555" Cursor="Hand"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="⚡ Generuj dla całej klasy" Click="GenerateForClass_Click" Height="30" Padding="12,0" Margin="5,0,0,0"
                            Background="#007ACC" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABELA KODÓW UCZNIÓW -->
        <DataGrid Grid.Row="2" x:Name="CodesDataGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  Background="#252526" RowBackground="#1E1E1E" AlternatingRowBackground="#252526"
                  BorderBrush="#3F3F46" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333337"
                  HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2D2D30"/>
                    <Setter Property="Foreground" Value="#00B0FF"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderBrush" Value="#3F3F46"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nr" Binding="{Binding JournalNumber}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Uczeń" Binding="{Binding StudentName}" Width="180" IsReadOnly="True"/>
                
                <DataGridTemplateColumn Header="Kod aktywacyjny MatApp" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ActivationCode}" FontWeight="Bold" FontFamily="Consolas" FontSize="13"
                                       Foreground="#00E5FF" VerticalAlignment="Center" Padding="4,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Status urządzenia" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Padding="4,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Data aktywacji" Binding="{Binding ActivatedAtText}" Width="130" IsReadOnly="True"/>

                <DataGridTemplateColumn Header="Akcje" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Nowy kod ↻" Click="RegenerateSingleCode_Click"
                                    Height="24" Padding="8,0" Background="#3E2723" Foreground="#FFCCBC"
                                    BorderBrush="#BF360C" Cursor="Hand" ToolTip="Unieważnia stary kod i generuje nowy dla tego ucznia"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- PASEK DOLNY / EKSPORT -->
        <Border Grid.Row="3" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
            <Grid>
                <TextBlock x:Name="StatusTextBlock" Text="Wybierz klasę, aby zarządzać kodami." Foreground="#888888" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📋 Kopiuj listę do schowka" Click="CopyListToClipboard_Click" Height="30" Padding="14,0" Margin="0,0,10,0"
                            Background="#2E4A2E" Foreground="White" BorderBrush="#4CAF50" Cursor="Hand"/>
                    <Button Content="💾 Eksportuj CSV" Click="ExportToCsv_Click" Height="30" Padding="14,0" Margin="0,0,10,0"
                            Background="#333337" Foreground="#E0E0E0" BorderBrush="#555555" Cursor="Hand"/>
                    <Button Content="Zamknij" Click="Close_Click" Height="30" Padding="14,0"
                            Background="#333337" Foreground="#E0E0E0" BorderBrush="#555555" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
