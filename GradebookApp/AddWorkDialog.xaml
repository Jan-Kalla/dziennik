<Window x:Class="GradebookApp.AddWorkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj ocenę" MinWidth="470" MaxWidth="1600" MinHeight="600" MaxHeight="900" SizeToContent="Height" Width="470" WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#E0E0E0">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Kategoria oceny:" Margin="0,0,0,5" FontSize="14"/>
        <ComboBox x:Name="WorkTypeComboBox" Grid.Row="1" Height="28" Margin="0,0,0,10" FontSize="14" SelectionChanged="WorkTypeComboBox_SelectionChanged">
            <ComboBoxItem Content="kartkówka" IsSelected="True"/>
            <ComboBoxItem Content="sprawdzian"/>
            <ComboBoxItem Content="aktywność"/>
            <ComboBoxItem Content="inne"/>
        </ComboBox>

        <TextBlock Text="Tytuł oceny:" Grid.Row="2" Margin="0,0,0,5" FontSize="14"/>
        <TextBox x:Name="TitleTextBox" Grid.Row="3" Height="28" Margin="0,0,0,10" FontSize="14" VerticalContentAlignment="Center"/>

        <TextBlock x:Name="MaxPointsLabel" Text="Max:" Grid.Row="4" Margin="0,0,0,5" FontSize="14" FontWeight="Bold" Foreground="#4DB6AC"/>
        <TextBox x:Name="MaxPointsTextBox" Grid.Row="5" Height="28" Margin="0,0,0,15" FontSize="14" VerticalContentAlignment="Center"/>

        <Grid Grid.Row="6" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="Data napisania:" Margin="0,0,0,5" FontSize="14"/>
                <DatePicker x:Name="DateWrittenPicker" Height="28" FontSize="14"/>
            </StackPanel>
            
            <StackPanel Grid.Column="2">
                <TextBlock Text="Data wpisania (opcj.):" Margin="0,0,0,5" FontSize="14"/>
                <DatePicker x:Name="DateEnteredPicker" Height="28" FontSize="14"/>
            </StackPanel>
        </Grid>

        <CheckBox x:Name="HasGroupsCheckBox" Content="Opcjonalnie: Punkty za zadania zależą od grupy" Grid.Row="7" FontSize="13" Foreground="#4DB6AC" FontWeight="Bold" Margin="0,0,0,15" Checked="HasGroupsCheckBox_Changed" Unchecked="HasGroupsCheckBox_Changed"/>

        <Border x:Name="GroupManagementPanel" Grid.Row="8" Visibility="Collapsed" Margin="0,0,0,15" Background="#2D2D30" Padding="10" CornerRadius="5">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Dodaj nową grupę:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0" Foreground="#FFB74D"/>
                    <TextBlock Text="Nazwa (np. C):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="NewGroupNameTextBox" Width="40" Height="28" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,10,0"/>
                    <Button Content="Dodaj" Width="70" Height="28" Click="AddGroup_Click" Cursor="Hand"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Zarządzaj grupą:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0" Foreground="#FFB74D"/>
                    <ComboBox x:Name="GroupsComboBox" Width="50" Height="28" FontSize="14" Margin="0,0,10,0" SelectionChanged="GroupsComboBox_SelectionChanged"/>
                    <TextBlock Text="Liczba zadań:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="EditGroupTaskCountTextBox" Width="40" Height="28" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,10,0"/>
                    <Button Content="Zmień" Width="60" Height="28" Click="UpdateGroupTaskCount_Click" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button Content="Usuń" Width="60" Height="28" Click="RemoveGroup_Click" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel x:Name="BaseTaskCountPanel" Grid.Row="9" Margin="0,0,0,10">
            <TextBlock Text="Liczba zadań:" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="TaskCountTextBox" Height="28" FontSize="14" VerticalContentAlignment="Center" TextChanged="TaskCountTextBox_TextChanged"/>
        </StackPanel>

        <DataGrid x:Name="TasksDataGrid" Grid.Row="10" Margin="0,0,0,15" FontSize="14" MinHeight="150"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="Cell"
                  BeginningEdit="TasksDataGrid_BeginningEdit" PreviewKeyDown="TasksDataGrid_PreviewKeyDown"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Resources>
                <Style x:Key="ReadOnlyCellStyle" TargetType="DataGridCell">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="IsTabStop" Value="False"/>
                    <Setter Property="Background" Value="#2D2D30"/>
                    <Setter Property="Foreground" Value="#AAAAAA"/>
                </Style>
            </DataGrid.Resources>
        </DataGrid>

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Anuluj" Width="80" Height="30" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Zapisz" Width="80" Height="30" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>