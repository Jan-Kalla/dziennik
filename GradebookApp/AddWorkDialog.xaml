<Window x:Class="GradebookApp.AddWorkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj pracę pisemną" Width="450" Height="730" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="#E0E0E0">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Rodzaj pracy:" Margin="0,0,0,5" FontSize="14"/>
        <ComboBox x:Name="WorkTypeComboBox" Grid.Row="1" Height="28" Margin="0,0,0,10" FontSize="14">
            <ComboBoxItem Content="kartkówka" IsSelected="True"/>
            <ComboBoxItem Content="sprawdzian"/>
            <ComboBoxItem Content="inne"/>
        </ComboBox>

        <TextBlock Text="Tytuł pracy:" Grid.Row="2" Margin="0,0,0,5" FontSize="14"/>
        <TextBox x:Name="TitleTextBox" Grid.Row="3" Height="28" Margin="0,0,0,10" FontSize="14" VerticalContentAlignment="Center"/>

        <!-- Ciemniejszy, pasujący kolor zamiast jaskrawego niebieskiego -->
        <TextBlock Text="Max punktów końcowych (M):" Grid.Row="4" Margin="0,0,0,5" FontSize="14" FontWeight="Bold" Foreground="#4DB6AC"/>
        <TextBox x:Name="MaxPointsTextBox" Grid.Row="5" Height="28" Margin="0,0,0,15" FontSize="14" VerticalContentAlignment="Center"/>

        <Grid Grid.Row="6" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="Data napisania:" Margin="0,0,0,5" FontSize="14"/>
                <DatePicker x:Name="DateWrittenPicker" Height="28" FontSize="14"/>
            </StackPanel>
            
            <StackPanel Grid.Column="2">
                <TextBlock Text="Data wpisania (opcj.):" Margin="0,0,0,5" FontSize="14"/>
                <DatePicker x:Name="DateEnteredPicker" Height="28" FontSize="14"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Liczba zadań:" Grid.Row="7" Margin="0,0,0,5" FontSize="14"/>
        <TextBox x:Name="TaskCountTextBox" Grid.Row="8" Height="28" Margin="0,0,0,10" FontSize="14" VerticalContentAlignment="Center" TextChanged="TaskCountTextBox_TextChanged"/>

        <DataGrid x:Name="TasksDataGrid" Grid.Row="9" Margin="0,0,0,15" FontSize="14" 
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="Cell">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Zadanie" Binding="{Binding TaskNumber}" IsReadOnly="True" Width="70"/>
                <DataGridTextColumn Header="Poziom I" Binding="{Binding MaxPointsLevel1}" Width="*" />
                <DataGridTextColumn Header="Poziom II" Binding="{Binding MaxPointsLevel2}" Width="*" />
                <DataGridTextColumn Header="Poziom III" Binding="{Binding MaxPointsLevel3}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Anuluj" Width="80" Height="30" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Zapisz" Width="80" Height="30" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>