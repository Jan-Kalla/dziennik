<Window x:Class="GradebookApp.AddGlobalWorkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj pracę pisemną dla wielu klas" Width="500" Height="850" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="#E0E0E0">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Wybierz klasy, do których przypisać pracę:" Grid.Row="0" Margin="0,0,0,5" FontSize="14" FontWeight="Bold"/>
        <!-- Zmieniony BorderBrush z LightGray na ciemny #434346 -->
        <Border Grid.Row="1" BorderBrush="#434346" BorderThickness="1" CornerRadius="3" Margin="0,0,0,15">
            <ListBox x:Name="ClassesListBox" Height="100" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding ClassName}" IsChecked="{Binding IsSelected}" FontSize="14" Margin="5,3"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Text="Rodzaj pracy:" Grid.Row="2" Margin="0,0,0,5" FontSize="14"/>
        <ComboBox x:Name="WorkTypeComboBox" Grid.Row="3" Height="28" Margin="0,0,0,10" FontSize="14">
            <ComboBoxItem Content="kartkówka" IsSelected="True"/>
            <ComboBoxItem Content="sprawdzian"/>
            <ComboBoxItem Content="inne"/>
        </ComboBox>

        <TextBlock Text="Tytuł pracy:" Grid.Row="4" Margin="0,0,0,5" FontSize="14"/>
        <TextBox x:Name="TitleTextBox" Grid.Row="5" Height="28" Margin="0,0,0,10" FontSize="14" VerticalContentAlignment="Center"/>

        <TextBlock Text="Max punktów końcowych (M):" Grid.Row="6" Margin="0,0,0,5" FontSize="14" FontWeight="Bold" Foreground="#4DB6AC"/>
        <TextBox x:Name="MaxPointsTextBox" Grid.Row="7" Height="28" Margin="0,0,0,15" FontSize="14" VerticalContentAlignment="Center"/>

        <Grid Grid.Row="8" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="Data napisania:" Margin="0,0,0,5" FontSize="14"/>
                <DatePicker x:Name="DateWrittenPicker" Height="28" FontSize="14"/>
            </StackPanel>
            
            <StackPanel Grid.Column="2">
                <TextBlock Text="Data wpisania (opcj.):" Margin="0,0,0,5" FontSize="14"/>
                <DatePicker x:Name="DateEnteredPicker" Height="28" FontSize="14"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Liczba zadań:" Grid.Row="9" Margin="0,0,0,5" FontSize="14"/>
        <TextBox x:Name="TaskCountTextBox" Grid.Row="10" Height="28" Margin="0,0,0,10" FontSize="14" VerticalContentAlignment="Center" TextChanged="TaskCountTextBox_TextChanged"/>

        <DataGrid x:Name="TasksDataGrid" Grid.Row="11" Margin="0,0,0,15" FontSize="14" 
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="Cell">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Zadanie" Binding="{Binding TaskNumber}" IsReadOnly="True" Width="70"/>
                <DataGridTextColumn Header="Poziom I" Binding="{Binding MaxPointsLevel1}" Width="*" />
                <DataGridTextColumn Header="Poziom II" Binding="{Binding MaxPointsLevel2}" Width="*" />
                <DataGridTextColumn Header="Poziom III" Binding="{Binding MaxPointsLevel3}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Anuluj" Width="80" Height="30" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Rozdziel pracę do klas" Width="160" Height="30" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>