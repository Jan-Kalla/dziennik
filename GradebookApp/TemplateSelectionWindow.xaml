<Window x:Class="GradebookApp.TemplateSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wybierz szablon" Width="450" Height="550" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="#E0E0E0">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchTextBox" Height="30" Margin="0,0,0,10" VerticalContentAlignment="Center" FontSize="14" TextChanged="Filter_Changed">
            <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                        <VisualBrush.Visual>
                                            <TextBlock Text="Szukaj po nazwie..." Foreground="#888888" Margin="5,0,0,0" FontStyle="Italic"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Filtruj wg kategorii:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
            <ComboBox x:Name="TypeFilterComboBox" Width="150" Height="28" FontSize="14" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Wszystkie" IsSelected="True"/>
                <ComboBoxItem Content="kartkówka"/>
                <ComboBoxItem Content="sprawdzian"/>
                <ComboBoxItem Content="inne"/>
            </ComboBox>
        </StackPanel>

        <ListBox x:Name="TemplatesListBox" Grid.Row="2" Margin="0,0,0,15" FontSize="15" Cursor="Hand" Background="#252526" Foreground="#E0E0E0" BorderBrush="#333" SelectionChanged="TemplatesListBox_SelectionChanged" MouseDoubleClick="TemplatesListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="{Binding WorkType, StringFormat=[{0}]}" Foreground="#4DB6AC" FontWeight="Bold" Margin="0,0,10,0" Width="105"/>
                        <TextBlock Text="{Binding Title}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- NOWY PANEL PODGLĄDU -->
        <Border Grid.Row="3" Background="#2D2D30" BorderBrush="#434346" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Szybki podgląd struktury:" FontWeight="Bold" Foreground="#4DB6AC" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="PreviewMaxPointsText" Text="Max punktów: -" Foreground="#AAAAAA" Margin="0,2" FontSize="13"/>
                        <TextBlock x:Name="PreviewGroupsText" Text="Liczba grup: -" Foreground="#AAAAAA" Margin="0,2" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="PreviewTasksText" Text="Liczba zadań: -" Foreground="#AAAAAA" Margin="0,2" FontSize="13"/>
                        <TextBlock x:Name="PreviewTypeText" Text="Kategoria: -" Foreground="#AAAAAA" Margin="0,2" FontSize="13"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Anuluj" Width="80" Height="30" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Wybierz" Width="100" Height="30" Click="Select_Click" IsDefault="True" Background="#007ACC" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>