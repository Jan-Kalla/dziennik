<Window x:Class="GradebookApp.LessonInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informacje o lekcji" Height="450" Width="600" 
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#E0E0E0">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="InfoHeader" Grid.Row="0" Text="INFORMACJE" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#007ACC" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Temat:" FontSize="14" Foreground="#AAAAAA" Margin="0,0,0,5" />
            <ComboBox x:Name="TopicComboBox" IsEditable="True" ToolTip="Wybierz z rozkładu materiału lub wpisz własny temat" IsTextSearchEnabled="False" StaysOpenOnEdit="True" KeyUp="TopicComboBox_KeyUp"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Realizowany materiał:" FontSize="14" Foreground="#AAAAAA" Margin="0,0,0,5" />
            <ComboBox x:Name="MaterialComboBox" IsEditable="True" ToolTip="Wybierz z rozkładu materiału lub wpisz własny" IsTextSearchEnabled="False" StaysOpenOnEdit="True" KeyUp="MaterialComboBox_KeyUp"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="Uwagi:" FontSize="14" Foreground="#AAAAAA" Margin="0,0,0,5" />
            <TextBox x:Name="NotesTextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" ToolTip="Dodatkowe informacje (np. zachowanie uczniów, trudności sprzętowe)"/>
        </StackPanel>

        <!-- Dolne Przyciski -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <!-- NOWY PRZYCISK -->
                <Button Content="Widok klasy" Background="#007ACC" Foreground="White" BorderThickness="0" Padding="15,8" Margin="0,0,10,0" Cursor="Hand" Click="GoToClassView_Click" ToolTip="Otwórz pełny widok tej klasy" FontWeight="Bold"/>
                
                <Button Content="Dodaj ocenę" Background="#4A2E2E" Foreground="White" BorderThickness="0" Padding="15,8" Margin="0,0,10,0" Cursor="Hand" Click="PlanWork_Click" ToolTip="Otwórz kreator pracy pisemnej" FontWeight="Bold"/>
                <Button Content="Zaplanuj poprawę" Background="#825a2c" Foreground="White" BorderThickness="0" Padding="15,8" Cursor="Hand" Click="PlanRetake_Click" ToolTip="Zaplanuj poprawę do wybranej pracy dla wybranej klasy" FontWeight="Bold"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Anuluj" Background="#3E3E42" Foreground="White" BorderThickness="0" Padding="15,8" Margin="0,0,10,0" Cursor="Hand" Click="Cancel_Click" />
                <Button Content="Zapisz" Background="#2E4A2E" Foreground="White" BorderThickness="0" Padding="15,8" Cursor="Hand" Click="Save_Click" FontWeight="Bold" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>