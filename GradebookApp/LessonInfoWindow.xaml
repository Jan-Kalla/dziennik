<Window x:Class="GradebookApp.LessonInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informacje o lekcji" Height="450" Width="600" 
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#E0E0E0">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="CaretBrush" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style x:Key="DropDownButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="0,2,2,0">
                            <Path x:Name="Arrow" Data="M 0 0 L 3.5 3.5 L 7 0" Stroke="#AAAAAA" StrokeThickness="1.5" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3E3E42"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="Arrow" Property="Stroke" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#007ACC"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="Arrow" Property="Stroke" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SuggestionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="InfoHeader" Grid.Row="0" Text="INFORMACJE" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#007ACC" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Temat:" FontSize="14" Foreground="#AAAAAA" Margin="0,0,0,5" />
            <Grid Height="32">
                <TextBox x:Name="TopicTextBox" 
                         Background="#333337" 
                         Foreground="#E0E0E0" 
                         CaretBrush="#E0E0E0"
                         BorderBrush="#555555" 
                         BorderThickness="1" 
                         Padding="8,0,28,0" 
                         VerticalContentAlignment="Center" 
                         FontSize="13" 
                         ToolTip="Wybierz z rozkładu materiału lub wpisz własny temat"
                         TextChanged="TopicTextBox_TextChanged"
                         PreviewKeyDown="TopicTextBox_PreviewKeyDown"/>

                <ToggleButton x:Name="TopicDropDownButton" 
                              Width="24" 
                              HorizontalAlignment="Right" 
                              VerticalAlignment="Stretch" 
                              Margin="0,1,1,1" 
                              Focusable="False" 
                              Style="{StaticResource DropDownButtonStyle}"
                              IsChecked="{Binding IsOpen, ElementName=TopicPopup, Mode=TwoWay}"
                              Click="TopicDropDownButton_Click"/>

                <Popup x:Name="TopicPopup" 
                       PlacementTarget="{Binding ElementName=TopicTextBox}" 
                       Placement="Bottom" 
                       StaysOpen="False" 
                       AllowsTransparency="True" 
                       Focusable="False" 
                       PopupAnimation="Fade">
                    <Border Background="#252526" BorderBrush="#555555" BorderThickness="1" 
                            Width="{Binding ActualWidth, ElementName=TopicTextBox}" 
                            MaxHeight="220" Margin="0,2,0,0" CornerRadius="2" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.5" Direction="270" Color="Black"/>
                        </Border.Effect>
                        <ListBox x:Name="TopicListBox" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="#E0E0E0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemContainerStyle="{StaticResource SuggestionItemStyle}"
                                 SelectionChanged="TopicListBox_SelectionChanged"
                                 PreviewKeyDown="TopicListBox_PreviewKeyDown"/>
                    </Border>
                </Popup>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Realizowany materiał:" FontSize="14" Foreground="#AAAAAA" Margin="0,0,0,5" />
            <Grid Height="32">
                <TextBox x:Name="MaterialTextBox" 
                         Background="#333337" 
                         Foreground="#E0E0E0" 
                         CaretBrush="#E0E0E0"
                         BorderBrush="#555555" 
                         BorderThickness="1" 
                         Padding="8,0,28,0" 
                         VerticalContentAlignment="Center" 
                         FontSize="13" 
                         ToolTip="Wybierz z rozkładu materiału lub wpisz własny"
                         TextChanged="MaterialTextBox_TextChanged"
                         PreviewKeyDown="MaterialTextBox_PreviewKeyDown"/>

                <ToggleButton x:Name="MaterialDropDownButton" 
                              Width="24" 
                              HorizontalAlignment="Right" 
                              VerticalAlignment="Stretch" 
                              Margin="0,1,1,1" 
                              Focusable="False" 
                              Style="{StaticResource DropDownButtonStyle}"
                              IsChecked="{Binding IsOpen, ElementName=MaterialPopup, Mode=TwoWay}"
                              Click="MaterialDropDownButton_Click"/>

                <Popup x:Name="MaterialPopup" 
                       PlacementTarget="{Binding ElementName=MaterialTextBox}" 
                       Placement="Bottom" 
                       StaysOpen="False" 
                       AllowsTransparency="True" 
                       Focusable="False" 
                       PopupAnimation="Fade">
                    <Border Background="#252526" BorderBrush="#555555" BorderThickness="1" 
                            Width="{Binding ActualWidth, ElementName=MaterialTextBox}" 
                            MaxHeight="220" Margin="0,2,0,0" CornerRadius="2" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.5" Direction="270" Color="Black"/>
                        </Border.Effect>
                        <ListBox x:Name="MaterialListBox" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="#E0E0E0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemContainerStyle="{StaticResource SuggestionItemStyle}"
                                 SelectionChanged="MaterialListBox_SelectionChanged"
                                 PreviewKeyDown="MaterialListBox_PreviewKeyDown"/>
                    </Border>
                </Popup>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="Uwagi:" FontSize="14" Foreground="#AAAAAA" Margin="0,0,0,5" />
            <TextBox x:Name="NotesTextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" ToolTip="Dodatkowe informacje (np. zachowanie uczniów, trudności sprzętowe)"/>
        </StackPanel>

        <!-- Dolne Przyciski -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <!-- NOWY PRZYCISK -->
                <Button Content="Widok klasy" Background="#007ACC" Foreground="White" BorderThickness="0" Padding="15,8" Margin="0,0,10,0" Cursor="Hand" Click="GoToClassView_Click" ToolTip="Otwórz pełny widok tej klasy" FontWeight="Bold"/>
                
                <Button Content="Dodaj ocenę" Background="#4A2E2E" Foreground="White" BorderThickness="0" Padding="15,8" Margin="0,0,10,0" Cursor="Hand" Click="PlanWork_Click" ToolTip="Otwórz kreator pracy pisemnej" FontWeight="Bold"/>
                <Button Content="Zaplanuj poprawę" Background="#825a2c" Foreground="White" BorderThickness="0" Padding="15,8" Cursor="Hand" Click="PlanRetake_Click" ToolTip="Zaplanuj poprawę do wybranej pracy dla wybranej klasy" FontWeight="Bold"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Anuluj" Background="#3E3E42" Foreground="White" BorderThickness="0" Padding="15,8" Margin="0,0,10,0" Cursor="Hand" Click="Cancel_Click" />
                <Button Content="Zapisz" Background="#2E4A2E" Foreground="White" BorderThickness="0" Padding="15,8" Cursor="Hand" Click="Save_Click" FontWeight="Bold" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>