<Window x:Class="GradebookApp.RetakeRequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lista chętnych na poprawy" Width="750" Height="550" WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#E0E0E0">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Uczniowie oczekujący na wyznaczenie terminu poprawy" FontSize="20" FontWeight="Bold" Foreground="#4DB6AC" Margin="0,0,0,15" HorizontalAlignment="Center"/>

        <DataGrid x:Name="RequestsDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" Background="#252526" Foreground="#E0E0E0" BorderBrush="#3E3E42" RowBackground="#2D2D30" AlternatingRowBackground="#252526" FontSize="15" Margin="0,0,0,15">
            <!-- Styl grupowania rozdzielający prace i klasy -->
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Margin" Value="0,0,0,5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander IsExpanded="True" Background="#333337" BorderBrush="#4DB6AC" BorderThickness="0,0,0,1">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal" Margin="5,8,0,8">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#4DB6AC" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                                    <Button Content="Zaplanuj / Przypisz uczniów" Padding="15,2" Cursor="Hand" Background="#007ACC" Foreground="White" BorderThickness="0" Click="AssignToRetake_Click"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsPresenter />
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nr" Binding="{Binding JournalNumber}" Width="50">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Imię i nazwisko ucznia" Binding="{Binding StudentName}" Width="*"/>
                <DataGridTemplateColumn Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Usuń zgłoszenie" Margin="2" Click="RemoveRequest_Click" Foreground="#E57373" Cursor="Hand" Background="#1E1E1E" BorderThickness="0" FontWeight="Bold"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Zamknij" Width="100" Height="30" HorizontalAlignment="Right" Click="Close_Click"/>
    </Grid>
</Window>