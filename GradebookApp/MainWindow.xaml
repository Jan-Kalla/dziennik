<Window x:Class="GradebookApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GradebookApp"
        Title="Dziennik" Height="720" Width="1080" WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#E0E0E0">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid Margin="15">
        <!-- GŁÓWNY KONTENER Z ZAKŁADKAMI -->
        <Grid x:Name="MainTabContainer">
            <!-- Usunięto narzucone tło, by WPF użył natywnego dla aplikacji (z niebieską linią) -->
            <TabControl x:Name="MainTabControl" FontSize="16" SelectionChanged="MainTabControl_SelectionChanged">

                <!-- ZAKŁADKA 1: LEKCJA -->
                <TabItem Header="Lekcja">
                    <local:LessonTabControl />
                </TabItem>

                <!-- ZAKŁADKA 2: KLASY -->
                <TabItem Header="Klasy">
                    <Grid Margin="10,20,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,25">
                            <TextBlock Text="Witaj w tym przecudownym dzienniku!" FontSize="14" Foreground="#AAAAAA" Margin="0,0,0,2" HorizontalAlignment="Center" />
                            <TextBlock Text="Baza wszystkich klas" FontSize="26" FontWeight="Bold" Foreground="#E0E0E0" HorizontalAlignment="Center" />
                        </StackPanel>

                        <ListBox x:Name="ClassesListBox" Grid.Row="1" Margin="0,0,0,15" FontSize="18" DisplayMemberPath="Name" BorderBrush="#3E3E42" BorderThickness="1" Background="#252526" Foreground="#E0E0E0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="15,10"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <EventSetter Event="MouseLeftButtonUp" Handler="ClassItem_MouseLeftButtonUp" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Otwórz klasę w nowym oknie" Click="OpenClassNewWindow_Click"/>
                                    <MenuItem Header="Edytuj nazwę" Click="EditClass_Click"/>
                                    <Separator />
                                    <MenuItem Header="Usuń klasę" Click="DeleteClass_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                        <Grid Grid.Row="2" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="NewClassNameTextBox" Height="35" FontSize="16" VerticalContentAlignment="Center" Padding="10,0" KeyDown="NewClassNameTextBox_KeyDown" TextChanged="NewClassNameTextBox_TextChanged" ToolTip="Wpisz nazwę nowej klasy..." />
                            
                            <TextBlock IsHitTestVisible="False" Text="Wpisz nazwę nowej klasy..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" FontSize="16" Foreground="DarkGray">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=NewClassNameTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button x:Name="AddClassButton" Grid.Column="1" Content="Dodaj klasę" Height="35" FontSize="16" Margin="10,0,0,0" Padding="15,0" Visibility="Collapsed" Click="AddClassButton_Click"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ZAKŁADKA 3: KALENDARZ -->
                <TabItem Header="Kalendarz">
                    <Grid Margin="10,20,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <CheckBox x:Name="ShowUpcomingGlobalOnlyCheckBox" Content="Pokaż tylko nadchodzące terminy" IsChecked="True" FontSize="14" Margin="0,0,20,0" Checked="RefreshGlobalCalendar_Click" Unchecked="RefreshGlobalCalendar_Click" />
                            <CheckBox x:Name="ShowAllGlobalWorksCheckBox" Content="Pokaż wszystkie prace (również pierwsze terminy)" FontSize="14" Checked="RefreshGlobalCalendar_Click" Unchecked="RefreshGlobalCalendar_Click" />
                        </StackPanel>

                        <DataGrid x:Name="GlobalCalendarDataGrid" Grid.Row="1" FontSize="16" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Edytuj poprawę" Click="EditGlobalRetake_Click"/>
                                    <MenuItem Header="Usuń poprawę" Click="DeleteGlobalRetake_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data" Binding="{Binding DateDisplay}" Width="100"/>
                                <DataGridTextColumn Header="Godz." Binding="{Binding TimeDisplay}" Width="70"/>
                                <DataGridTextColumn Header="Klasa" Binding="{Binding ClassName}" Width="80"/>
                                <DataGridTextColumn Header="Rodzaj" Binding="{Binding WorkType}" Width="100"/>
                                <DataGridTextColumn Header="Tytuł" Binding="{Binding Title}" Width="*"/>
                                
                                <DataGridTextColumn Binding="{Binding AttendeesCountDisplay}" Width="70">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Liczba&#x0a;osób" TextAlignment="Center"/>
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Button Content="Szczegóły" Margin="2" Click="ViewGlobalRetakeDetails_Click" Cursor="Hand" Visibility="{Binding IsRetake, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Edytuj" Click="EditGlobalRetake_Click"/>
                                                            <MenuItem Header="Usuń" Click="DeleteGlobalRetake_Click" Foreground="#E57373" FontWeight="Bold"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                                <TextBlock Text="Pierwszy termin" Foreground="#777777" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRetake}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                            <Button Content="Zaplanuj poprawę" Width="150" Height="35" Margin="0,0,20,0" Click="PlanGlobalRetake_Click"/>
                            <Button Background="#2E4A2E" BorderThickness="0" Click="ViewRetakeRequests_Click" Content="Wyświetl chętnych" Cursor="Hand" Foreground="White" Height="35" Margin="0,0,20,0" ToolTip="Pokazuje listę uczniów ze wszystkich klas zgłoszonych do poprawek" Width="150"/>
                            <Button Background="#00838F" BorderThickness="0" Click="SyncRetakes_Click" Content="Pobierz zapisy na poprawy (z chmury)" Cursor="Hand" Foreground="White" Height="35" Padding="20,0" ToolTip="Pobiera z chmury uczniów, którzy zapisali się na poprawę przez kalkulator"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ZAKŁADKA 4: INNE (Rozwijane Menu zamiast widoku) -->
                <TabItem x:Name="OtherTab" PreviewMouseLeftButtonDown="OtherTab_PreviewMouseLeftButtonDown">
                    <TabItem.Header>
                        <TextBlock Text="Inne ▾" Background="Transparent"/>
                    </TabItem.Header>
                    <TabItem.ContextMenu>
                        <!-- Menu otwierające się idealnie pod nagłówkiem -->
                        <ContextMenu x:Name="OtherMenu" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=TabItem}}">
                            <MenuItem Header="Statystyki popraw" Click="OpenStatisticsWindow_Click"/>
                            <MenuItem Header="Menadżer szablonów" Click="OpenTemplateManager_Click"/>
                            <Separator/>
                            <MenuItem Header="☁ Synchronizuj z chmurą" Click="SyncCloud_Click"/>
                        </ContextMenu>
                    </TabItem.ContextMenu>
                    <!-- Pusta zawartość (Nigdy się nie wyświetli przez kod C# blokujący akcję zmiany karty) -->
                    <Grid/>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- WIDOK 2: SZCZEGÓŁY KLASY (Nakładka przykrywająca zakładki, by nie psuć dotychczasowego kodu) -->
        <Grid x:Name="ClassDetailsView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <Button Content="← Powrót do bazy klas" Width="150" Height="30" Margin="0,0,0,10" HorizontalAlignment="Left" Click="BackButton_Click" />
            <local:ClassDetailsControl x:Name="SharedClassControl" Grid.Row="1" />
        </Grid>
        
        <!-- WIDOK 3: SZCZEGÓŁY UCZNIA -->
        <Grid x:Name="StudentDetailsView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <Button Content="← Powrót do klasy" Width="130" Height="30" Margin="0,0,0,10" HorizontalAlignment="Left" Click="BackToClassFromStudent_Click" />
            <local:StudentDetailsControl x:Name="SharedStudentControl" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>