<Window x:Class="GradebookApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GradebookApp"
        Title="Dziennik" Height="720" Width="1080" WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#E0E0E0">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid Margin="15">
        <!-- GŁÓWNY KONTENER Z ZAKŁADKAMI -->
        <Grid x:Name="MainTabContainer">
            
            <!-- POPUP PRZENIESIONY TUTAJ (Poza TabControl, by zawsze był gotowy do wyświetlenia) -->
            <!-- Zmieniono PlacementTarget na: {Binding ElementName=ClassesTab} -->
            <Popup x:Name="ClassesPopup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=ClassesTab}" StaysOpen="False">
                <Border Background="#252526" BorderBrush="#434346" BorderThickness="1" CornerRadius="3" MaxHeight="500" MinWidth="250">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <ListBox x:Name="ClassesDropdownList" Background="Transparent" BorderThickness="0" DisplayMemberPath="Name" Foreground="#E0E0E0" Padding="0,5" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="15,10"/>
                                    <Setter Property="FontSize" Value="16"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <EventSetter Event="MouseLeftButtonUp" Handler="ClassDropdownItem_Click"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#333337"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="OpenClassNewWindow_Click" Header="Otwórz klasę w nowym oknie"/>
                                    <MenuItem Click="EditClass_Click" Header="Edytuj nazwę"/>
                                    <Separator/>
                                    <MenuItem Click="DeleteClass_Click" Foreground="#E53935" Header="Usuń klasę"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                        
                        <Border Background="#1E1E1E" BorderBrush="#434346" BorderThickness="0,1,0,0" Grid.Row="1" Padding="5">
                            <TextBox x:Name="DropdownNewClassTextBox" Background="#333337" BorderThickness="0" FontSize="14" Foreground="#E0E0E0" Height="32" KeyDown="DropdownNewClassTextBox_KeyDown" Padding="10,0" VerticalContentAlignment="Center">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                            <VisualBrush.Visual>
                                                                <!-- ZMIENIONO TEKST PODPOWIEDZI -->
                                                                <TextBlock FontStyle="Italic" Foreground="#888888" Text="Dodaj klasę..."/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Border>
                    </Grid>
                </Border>
            </Popup>

            <!-- GŁÓWNY TAB CONTROL -->
            <TabControl x:Name="MainTabControl" FontSize="16" SelectionChanged="MainTabControl_SelectionChanged">

                <!-- ZAKŁADKA 1: LEKCJA -->
                <TabItem Header="Lekcja">
                    <local:LessonTabControl />
                </TabItem>

                <!-- ZAKŁADKA 2: KLASY (Odchudzona, służy tylko jako kontener) -->
                <TabItem x:Name="ClassesTab" PreviewMouseLeftButtonDown="ClassesTab_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="ClassesTab_PreviewMouseLeftButtonUp">
                    <TabItem.Header>
                        <TextBlock Background="Transparent" Text="Klasy ▾"/>
                    </TabItem.Header>
                    <Grid>
                        <local:ClassDetailsControl x:Name="SharedClassControl" Visibility="Collapsed" />
                        
                        <Grid x:Name="StudentDetailsView" Background="#1E1E1E" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Background="#333337" BorderThickness="0" Click="BackToClassFromStudent_Click" Content="← Powrót do klasy" Cursor="Hand" Foreground="White" Height="30" HorizontalAlignment="Left" Margin="10,10,0,10" Width="130"/>
                            <local:StudentDetailsControl x:Name="SharedStudentControl" Grid.Row="1" />
                        </Grid>
                    </Grid>
                </TabItem>
                <!-- ZAKŁADKA 3: KALENDARZ -->
                <TabItem Header="Kalendarz">
                    <Grid Margin="10,20,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <CheckBox x:Name="ShowUpcomingGlobalOnlyCheckBox" Content="Pokaż tylko nadchodzące terminy" IsChecked="True" FontSize="14" Margin="0,0,20,0" Checked="RefreshGlobalCalendar_Click" Unchecked="RefreshGlobalCalendar_Click" />
                            <CheckBox x:Name="ShowAllGlobalWorksCheckBox" Content="Pokaż wszystkie prace (również pierwsze terminy)" FontSize="14" Checked="RefreshGlobalCalendar_Click" Unchecked="RefreshGlobalCalendar_Click" />
                        </StackPanel>

                        <DataGrid x:Name="GlobalCalendarDataGrid" Grid.Row="1" FontSize="16" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Edytuj poprawę" Click="EditGlobalRetake_Click"/>
                                    <MenuItem Header="Usuń poprawę" Click="DeleteGlobalRetake_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data" Binding="{Binding DateDisplay}" Width="100"/>
                                <DataGridTextColumn Header="Godz." Binding="{Binding TimeDisplay}" Width="70"/>
                                <DataGridTextColumn Header="Klasa" Binding="{Binding ClassName}" Width="80"/>
                                <DataGridTextColumn Header="Rodzaj" Binding="{Binding WorkType}" Width="100"/>
                                <DataGridTextColumn Header="Tytuł" Binding="{Binding Title}" Width="*"/>
                                
                                <DataGridTextColumn Binding="{Binding AttendeesCountDisplay}" Width="70">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Liczba&#x0a;osób" TextAlignment="Center"/>
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Button Content="Szczegóły" Margin="2" Click="ViewGlobalRetakeDetails_Click" Cursor="Hand" Visibility="{Binding IsRetake, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Edytuj" Click="EditGlobalRetake_Click"/>
                                                            <MenuItem Header="Usuń" Click="DeleteGlobalRetake_Click" Foreground="#E57373" FontWeight="Bold"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                                <TextBlock Text="Pierwszy termin" Foreground="#777777" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRetake}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                            <Button Content="Zaplanuj poprawę" Width="150" Height="35" Margin="0,0,20,0" Click="PlanGlobalRetake_Click"/>
                            <Button Background="#2E4A2E" BorderThickness="0" Click="ViewRetakeRequests_Click" Content="Wyświetl chętnych" Cursor="Hand" Foreground="White" Height="35" Margin="0,0,20,0" ToolTip="Pokazuje listę uczniów ze wszystkich klas zgłoszonych do poprawek" Width="150"/>
                            <Button Background="#00838F" BorderThickness="0" Click="SyncRetakes_Click" Content="Pobierz zapisy na poprawy (z chmury)" Cursor="Hand" Foreground="White" Height="35" Padding="20,0" ToolTip="Pobiera z chmury uczniów, którzy zapisali się na poprawę przez kalkulator"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ZAKŁADKA 4: INNE (Rozwijane Menu zamiast widoku) -->
                <TabItem x:Name="OtherTab" PreviewMouseLeftButtonDown="OtherTab_PreviewMouseLeftButtonDown">
                    <TabItem.Header>
                        <TextBlock Text="Inne ▾" Background="Transparent"/>
                    </TabItem.Header>
                    <TabItem.ContextMenu>
                        <!-- Menu otwierające się idealnie pod nagłówkiem -->
                        <ContextMenu x:Name="OtherMenu" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=TabItem}}">
                            <MenuItem Header="Rozkład materiału" Click="OpenCurriculumWindow_Click" FontWeight="Bold" Foreground="#4DB6AC"/>
                            <MenuItem Header="Statystyki popraw" Click="OpenStatisticsWindow_Click"/>
                            <MenuItem Header="Menadżer szablonów" Click="OpenTemplateManager_Click"/>
                            <Separator/>
                            <MenuItem Header="☁ Synchronizuj z chmurą" Click="SyncCloud_Click"/>
                        </ContextMenu>
                    </TabItem.ContextMenu>
                    <!-- Pusta zawartość (Nigdy się nie wyświetli przez kod C# blokujący akcję zmiany karty) -->
                    <Grid/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>