<Window x:Class="GradebookApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GradebookApp"
        Title="Dziennik" Height="720" Width="1080" WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#E0E0E0"
        Icon="icon2.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="WatermarkTextBoxStyle" TargetType="{x:Type TextBox}">
           
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <!-- WIDOK 1: LISTA KLAS -->
        <Grid x:Name="ClassesListView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,25">
                <TextBlock Text="Witaj w tym przecudownym dzienniku!" FontSize="14" Foreground="#AAAAAA" Margin="0,0,0,2" HorizontalAlignment="Center" />
                <TextBlock Text="Baza wszystkich klas" FontSize="26" FontWeight="Bold" Foreground="#E0E0E0" HorizontalAlignment="Center" />
            </StackPanel>

            <ListBox x:Name="ClassesListBox" Grid.Row="1" Margin="0,0,0,15" FontSize="18" DisplayMemberPath="Name" BorderBrush="#3E3E42" BorderThickness="1">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <EventSetter Event="MouseLeftButtonUp" Handler="ClassItem_MouseLeftButtonUp" />
                    </Style>
                </ListBox.ItemContainerStyle>
                
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Otwórz klasę w nowym oknie" Click="OpenClassNewWindow_Click"/>
                        <MenuItem Header="Edytuj nazwę" Click="EditClass_Click"/>
                        <Separator />
                        <MenuItem Header="Usuń klasę" Click="DeleteClass_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <Grid Grid.Row="2" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <!-- Pole tekstowe (bez atrybutu Style) -->
                <TextBox x:Name="NewClassNameTextBox" Height="35" FontSize="16" VerticalContentAlignment="Center" KeyDown="NewClassNameTextBox_KeyDown" TextChanged="NewClassNameTextBox_TextChanged" ToolTip="Wpisz nazwę nowej klasy..." />
                
                <!-- Nakładka tekstowa (Watermark) działająca niezależnie -->
                <TextBlock IsHitTestVisible="False" Text="Wpisz nazwę klasy..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="7,0,0,0" FontSize="16" Foreground="DarkGray">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- Pokazuje napis tylko, gdy TextBox jest pusty -->
                                <DataTrigger Binding="{Binding Text, ElementName=NewClassNameTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Przycisk bazowo ukryty, pojawia się po prawej stronie pola -->
                <Button x:Name="AddClassButton" Grid.Column="1" Content="Dodaj" Height="35" FontSize="16" Margin="10,0,0,0" Padding="15,0" Visibility="Collapsed" Click="AddClassButton_Click"/>
            </Grid>
            
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Nowy przycisk statystyk w miejscu starego dodawania -->
                <Button Grid.Column="0" Content="Statystyki" Height="45" FontSize="16" Click="OpenStatisticsWindow_Click"/>
                <Button Grid.Column="2" Content="Szablony" Height="45" FontSize="16" Click="OpenTemplateManager_Click" Background="#2E4A2E" BorderBrush="#4CAF50"/>
                <Button Grid.Column="4" Content="Kalendarz (Globalny)" Height="45" FontSize="16" Click="GlobalCalendarButton_Click" Background="#007ACC" BorderBrush="#005A9E"/>
                
                <Button Grid.Column="6" Content="☁ Synchronizuj" Height="45" FontSize="16" Click="SyncCloud_Click" Background="#512DA8" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Wypycha zaktualizowaną listę prac pisemnych do bazy chmurowej"/>
            </Grid>
        </Grid>

       <!-- WIDOK GLOBALNEGO KALENDARZA -->
        <Grid x:Name="GlobalCalendarView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Content="← Powrót do bazy klas" Width="150" Height="30" Margin="0,0,0,10" HorizontalAlignment="Left" Click="BackButton_Click" />
            
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                <CheckBox x:Name="ShowUpcomingGlobalOnlyCheckBox" Content="Pokaż tylko nadchodzące terminy" IsChecked="True" FontSize="14" Margin="0,0,20,0" Checked="RefreshGlobalCalendar_Click" Unchecked="RefreshGlobalCalendar_Click" />
                <CheckBox x:Name="ShowAllGlobalWorksCheckBox" Content="Pokaż wszystkie prace (również pierwsze terminy)" FontSize="14" Checked="RefreshGlobalCalendar_Click" Unchecked="RefreshGlobalCalendar_Click" />
            </StackPanel>

            <DataGrid x:Name="GlobalCalendarDataGrid" Grid.Row="2" FontSize="16" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow">
                
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Edytuj poprawę" Click="EditGlobalRetake_Click"/>
                        <MenuItem Header="Usuń poprawę" Click="DeleteGlobalRetake_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding DateDisplay}" Width="100"/>
                    <DataGridTextColumn Header="Godz." Binding="{Binding TimeDisplay}" Width="70"/>
                    <DataGridTextColumn Header="Klasa" Binding="{Binding ClassName}" Width="80"/>
                    <DataGridTextColumn Header="Rodzaj" Binding="{Binding WorkType}" Width="100"/>
                    <DataGridTextColumn Header="Tytuł" Binding="{Binding Title}" Width="*"/>
                    
                    <DataGridTextColumn Binding="{Binding AttendeesCountDisplay}" Width="70">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="Liczba&#x0a;osób" TextAlignment="Center"/>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Button Content="Szczegóły" Margin="2" Click="ViewGlobalRetakeDetails_Click" Cursor="Hand" Visibility="{Binding IsRetake, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Edytuj" Click="EditGlobalRetake_Click"/>
                                                <MenuItem Header="Usuń" Click="DeleteGlobalRetake_Click" Foreground="#E57373" FontWeight="Bold"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <TextBlock Text="Pierwszy termin" Foreground="#777777" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRetake}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Zaplanuj poprawę" Width="150" Height="35" Margin="0,0,20,0" Click="PlanGlobalRetake_Click"/>
                
                <Button Background="#2E4A2E" BorderThickness="0" Click="ViewRetakeRequests_Click" Content="Wyświetl chętnych" Cursor="Hand" Foreground="White" Height="35" Margin="0,0,20,0" ToolTip="Pokazuje listę uczniów ze wszystkich klas zgłoszonych do poprawek" Width="150"/>
                
                <Button Background="#00838F" BorderThickness="0" Click="SyncRetakes_Click" Content="Pobierz zapisy na poprawy (z chmury)" Cursor="Hand" Foreground="White" Height="35" Padding="20,0" ToolTip="Pobiera z chmury uczniów, którzy zapisali się na poprawę przez kalkulator"/>
            </StackPanel>
        </Grid>

        <!-- WIDOK 2: SZCZEGÓŁY KLASY -->
        <Grid x:Name="ClassDetailsView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <Button Content="← Powrót do bazy klas" Width="150" Height="30" Margin="0,0,0,10" HorizontalAlignment="Left" Click="BackButton_Click" />
            <local:ClassDetailsControl x:Name="SharedClassControl" Grid.Row="1" />
        </Grid>
        
        <!-- WIDOK 3: SZCZEGÓŁY UCZNIA -->
        <Grid x:Name="StudentDetailsView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <Button Content="← Powrót do klasy" Width="130" Height="30" Margin="0,0,0,10" HorizontalAlignment="Left" Click="BackToClassFromStudent_Click" />
            <local:StudentDetailsControl x:Name="SharedStudentControl" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>