<Window x:Class="GradebookApp.ClassHoursSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zestawienie godzin lekcyjnych klas w roku szkolnym" Height="720" Width="1440" MinWidth="960" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" Foreground="#E0E0E0">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="15,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitleText" Text="ZESTAWIENIE GODZIN LEKCYJNYCH KLAS — ROK SZKOLNY 2026 / 2027" 
                               FontSize="18" FontWeight="Bold" Foreground="#4DB6AC" Margin="0,0,0,6"/>
                    <TextBlock Text="Liczba godzin wyliczona na podstawie aktualnego planu lekcji nauczyciela oraz kalendarza dni nauki (od 1 września do 30 czerwca z uwzględnieniem dni wolnych i świąt)." 
                               FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,15,0"/>
                </StackPanel>

                <Border Grid.Column="1" VerticalAlignment="Center" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="15,0,0,0">
                    <CheckBox x:Name="RemainingOnlyCheckBox" 
                              Content="Tylko godziny pozostałe do końca roku" 
                              FontSize="13" FontWeight="SemiBold" Foreground="#E0E0E0" 
                              VerticalAlignment="Center" Cursor="Hand"
                              Checked="RemainingOnlyCheckBox_Changed" Unchecked="RemainingOnlyCheckBox_Changed"
                              ToolTip="Zaznacz, aby pokazać tylko liczbę godzin, która została do końca roku szkolnego (od dzisiaj do 30 czerwca), bez godzin, które już się odbyły."/>
                </Border>
            </Grid>
        </Border>

        <!-- Podsumowanie dni roboczych tygodnia -->
        <Border Grid.Row="1" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="GeneralStatsText" Text="Dni w roku szkolnym (Wrz - Cze): Robocze: 0 | Wolne: 0 (w tym weekendy: 0)" 
                           FontSize="14" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBlock x:Name="WorkingDaysSummaryText" Text="Dni nauki wg dni tygodnia: Pn: 0 | Wt: 0 | Śr: 0 | Czw: 0 | Pt: 0" 
                           FontSize="13" FontWeight="SemiBold" Foreground="#FFD54F" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Tabela klas -->
        <Border Grid.Row="2" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="10">
            <DataGrid x:Name="HoursDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                       IsReadOnly="True" Background="#1E1E1E" RowBackground="#252526" AlternatingRowBackground="#2D2D30" 
                       Foreground="#E0E0E0" BorderBrush="#434346" GridLinesVisibility="All" HorizontalGridLinesBrush="#3E3E42" 
                       VerticalGridLinesBrush="#3E3E42" SelectionMode="Single" SelectionUnit="FullRow" FontSize="14">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Klasa" Binding="{Binding ClassName}" Width="100" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Godz./tydz." Binding="{Binding WeeklyHours}" Width="85">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ColMon" Header="Pn (tydz. / rok)" Binding="{Binding MondayDetails}" Width="*"/>
                    <DataGridTextColumn x:Name="ColTue" Header="Wt (tydz. / rok)" Binding="{Binding TuesdayDetails}" Width="*"/>
                    <DataGridTextColumn x:Name="ColWed" Header="Śr (tydz. / rok)" Binding="{Binding WednesdayDetails}" Width="*"/>
                    <DataGridTextColumn x:Name="ColThu" Header="Czw (tydz. / rok)" Binding="{Binding ThursdayDetails}" Width="*"/>
                    <DataGridTextColumn x:Name="ColFri" Header="Pt (tydz. / rok)" Binding="{Binding FridayDetails}" Width="*"/>
                    <DataGridTextColumn x:Name="ColTotal" Header="Łącznie w roku" Binding="{Binding TotalYearHoursDisplay}" Width="135">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#4FC3F7"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Stopka z podsumowaniem i przyciskiem -->
        <Border Grid.Row="3" Margin="0,15,0,0">
            <Grid>
                <TextBlock x:Name="GrandTotalText" Text="Łącznie godzin wszystkich klas w roku: 0" 
                           FontSize="15" FontWeight="Bold" Foreground="#81D4FA" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Button Content="Zamknij" Click="Close_Click" Width="110" Height="34" 
                        Background="#333337" Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
