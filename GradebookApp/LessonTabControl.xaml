<UserControl x:Class="GradebookApp.LessonTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="#E0E0E0">
    <UserControl.Resources>
        
        <Style TargetType="DataGrid">
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="Cell"/>
        </Style>

        <Style x:Key="CellTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#333337"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCellsPresenter">
            <Setter Property="ClipToBounds" Value="False" />
        </Style>

        <Style x:Key="NoClipCellStyle" TargetType="DataGridCell">
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="GotFocus" Handler="DataGridCell_GotFocus"/> 
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#E0E0E0"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowAddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="ToolTip" Value="Wstaw nowy wiersz"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderAddButtonStyle" TargetType="Button" BasedOn="{StaticResource RowAddButtonStyle}">
            <Setter Property="ToolTip" Value="Wstaw wiersz na samej górze"/>
            <Style.Triggers>
                <!-- Pokazuje przycisk tylko, gdy najeżdżamy myszką na nagłówek -->
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="RowMenu" x:Shared="False" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Usuń ten wiersz" Click="DeleteRow_Click" Foreground="#E53935" FontWeight="Bold"/>
        </ContextMenu>

        <Style x:Key="RowStyleWithMenu" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Panel.ZIndex" Value="9999"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel x:Name="DateNavigationPanel" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Content="◀" Width="32" Height="32" Background="#3E3E42" Foreground="#E0E0E0" BorderThickness="0" Cursor="Hand" Click="PrevDay_Click" ToolTip="Poprzedni dzień" Margin="0,0,10,0" Focusable="False"/>
                <TextBlock x:Name="LessonDateText" Text="Dzisiaj: -" FontSize="20" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center" Width="300" TextAlignment="Center"/>
                <Button Content="▶" Width="32" Height="32" Background="#3E3E42" Foreground="#E0E0E0" BorderThickness="0" Cursor="Hand" Click="NextDay_Click" ToolTip="Następny dzień" Margin="10,0,0,0" Focusable="False"/>
            </StackPanel>

            <TextBlock x:Name="WeeklyTitleText" Grid.Column="0" Text="Rozkład tygodniowy" FontSize="20" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DailyViewBtn" Content="Widok dzienny" Width="140" Height="32" Background="#3E3E42" Foreground="White" BorderThickness="0" Click="DailyViewBtn_Click" Cursor="Hand" FontWeight="Bold" FontSize="15" Focusable="False"/>
                <Button x:Name="WeeklyViewBtn" Content="Widok tygodniowy" Width="160" Height="32" Background="#2D2D30" Foreground="#AAAAAA" BorderThickness="0" Click="WeeklyViewBtn_Click" Cursor="Hand" Margin="5,0,0,0" FontSize="15" Focusable="False"/>
            </StackPanel>
        </Grid>

        <!-- WIDOK DZIENNY -->
        <DataGrid x:Name="DailyScheduleGrid" Grid.Row="1" FontSize="16" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="False" HeadersVisibility="Column" Background="#1E1E1E" RowBackground="#252526" AlternatingRowBackground="#2D2D30" Foreground="#E0E0E0" BorderBrush="#3E3E42" GridLinesVisibility="All" RowStyle="{StaticResource RowStyleWithMenu}" PreviewKeyDown="TasksDataGrid_PreviewKeyDown">
            <DataGrid.Columns>
                <!-- Zintegrowana kolumna "Nr" połączona z przyciskami "+" do dodawania wierszy -->
                <DataGridTemplateColumn Width="45" CellStyle="{StaticResource NoClipCellStyle}">
                    <!-- Wymuszamy rozciągnięcie zawartości nagłówka na pełną szerokość -->
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <!-- Narzucenie kolorów z motywu -->
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#E0E0E0"/>
                            <!-- Wyłączenie ucinania brzegów komórki -->
                            <Setter Property="ClipToBounds" Value="False"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Grid ClipToBounds="False" Background="Transparent" Height="30">
                                <TextBlock Text="Nr" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E0E0E0"/>
                                <!-- Poprawiony margines dla plusa na górze -->
                                <Button Content="+" Style="{StaticResource HeaderAddButtonStyle}" Click="AddRowAtTop_Click" Height="20" Width="20" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-8" Panel.ZIndex="100"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid ClipToBounds="False" Background="Transparent" MinHeight="35">
                                <TextBlock Text="{Binding LessonNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888"/>
                                <Button Content="+" Style="{StaticResource RowAddButtonStyle}" Click="AddRowBelow_Click" Height="20" Width="20" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-10" Panel.ZIndex="100"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Godz." Width="120" CellStyle="{StaticResource NoClipCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <TextBox Text="{Binding TimeSlot, UpdateSourceTrigger=Explicit}" Style="{StaticResource CellTextBoxStyle}" Margin="0,5" LostFocus="TimeSlotTextBox_LostFocus"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Klasa (dyżur)" Width="150" CellStyle="{StaticResource NoClipCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <ComboBox IsEditable="True" Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.ClassNames, RelativeSource={RelativeSource AncestorType=UserControl}}" IsTextSearchEnabled="False" StaysOpenOnEdit="True" KeyUp="ClassComboBox_KeyUp" Background="Transparent" Foreground="#E0E0E0" BorderThickness="0" Padding="5">
                                    <ComboBox.Resources><Style TargetType="ToggleButton"><Setter Property="Visibility" Value="Collapsed"/></Style></ComboBox.Resources>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Zrealizowany materiał" Width="*" CellStyle="{StaticResource NoClipCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <!-- ZNAK WODNY Z HISTORIĄ MATERIAŁU -->
                                <TextBlock Text="{Binding MaterialWatermark}" Foreground="#666666" FontStyle="Italic" VerticalAlignment="Center" Margin="5,0" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <!-- Pokaż historię tylko, gdy pole jest puste -->
                                                <DataTrigger Binding="{Binding Material}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Material}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                
                                <!-- Właściwe pole edycji -->
                                <TextBox Text="{Binding Material, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellTextBoxStyle}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="60" CellStyle="{StaticResource NoClipCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><Grid Background="Transparent"><Button Content="→" Margin="2" Click="GoToLessonInfo_Click" Cursor="Hand" Background="#007ACC" Foreground="White" FontSize="18" FontWeight="Bold" ToolTip="Przejdź do okna informacji" Focusable="False"/></Grid></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- WIDOK TYGODNIOWY -->
        <DataGrid x:Name="WeeklyScheduleGrid" Grid.Row="1" FontSize="16" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="False" HeadersVisibility="Column" Background="#1E1E1E" RowBackground="#252526" AlternatingRowBackground="#2D2D30" Foreground="#E0E0E0" BorderBrush="#3E3E42" GridLinesVisibility="All" Visibility="Collapsed" RowStyle="{StaticResource RowStyleWithMenu}" PreviewKeyDown="TasksDataGrid_PreviewKeyDown">
            <DataGrid.Columns>
                <!-- Zintegrowana kolumna "Nr" połączona z przyciskami "+" do dodawania wierszy -->
                <DataGridTemplateColumn Width="45" CellStyle="{StaticResource NoClipCellStyle}">
                    <!-- Wymuszamy rozciągnięcie zawartości nagłówka na pełną szerokość -->
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <!-- Narzucenie kolorów z motywu -->
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#E0E0E0"/>
                            <!-- Wyłączenie ucinania brzegów komórki -->
                            <Setter Property="ClipToBounds" Value="False"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Grid ClipToBounds="False" Background="Transparent" Height="30">
                                <TextBlock Text="Nr" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E0E0E0"/>
                                <!-- Poprawiony margines dla plusa na górze -->
                                <Button Content="+" Style="{StaticResource HeaderAddButtonStyle}" Click="AddRowAtTop_Click" Height="20" Width="20" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-8" Panel.ZIndex="100"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid ClipToBounds="False" Background="Transparent" MinHeight="35">
                                <TextBlock Text="{Binding LessonNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888"/>
                                <Button Content="+" Style="{StaticResource RowAddButtonStyle}" Click="AddRowBelow_Click" Height="20" Width="20" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-10" Panel.ZIndex="100"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Godz." Width="120" CellStyle="{StaticResource NoClipCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <TextBox Text="{Binding TimeSlot, UpdateSourceTrigger=Explicit}" Style="{StaticResource CellTextBoxStyle}" Margin="0,5" LostFocus="TimeSlotTextBox_LostFocus"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Pon." Width="*" CellStyle="{StaticResource NoClipCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <ComboBox IsEditable="True" Text="{Binding MonClass, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.ClassNames, RelativeSource={RelativeSource AncestorType=UserControl}}" IsTextSearchEnabled="False" StaysOpenOnEdit="True" KeyUp="ClassComboBox_KeyUp" Background="Transparent" Foreground="#E0E0E0" BorderThickness="0" Padding="5">
                                    <ComboBox.Resources><Style TargetType="ToggleButton"><Setter Property="Visibility" Value="Collapsed"/></Style></ComboBox.Resources>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Wt." Width="*" CellStyle="{StaticResource NoClipCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <ComboBox IsEditable="True" Text="{Binding TueClass, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.ClassNames, RelativeSource={RelativeSource AncestorType=UserControl}}" IsTextSearchEnabled="False" StaysOpenOnEdit="True" KeyUp="ClassComboBox_KeyUp" Background="Transparent" Foreground="#E0E0E0" BorderThickness="0" Padding="5">
                                    <ComboBox.Resources><Style TargetType="ToggleButton"><Setter Property="Visibility" Value="Collapsed"/></Style></ComboBox.Resources>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Śr." Width="*" CellStyle="{StaticResource NoClipCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <ComboBox IsEditable="True" Text="{Binding WedClass, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.ClassNames, RelativeSource={RelativeSource AncestorType=UserControl}}" IsTextSearchEnabled="False" StaysOpenOnEdit="True" KeyUp="ClassComboBox_KeyUp" Background="Transparent" Foreground="#E0E0E0" BorderThickness="0" Padding="5">
                                    <ComboBox.Resources><Style TargetType="ToggleButton"><Setter Property="Visibility" Value="Collapsed"/></Style></ComboBox.Resources>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Czw." Width="*" CellStyle="{StaticResource NoClipCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <ComboBox IsEditable="True" Text="{Binding ThuClass, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.ClassNames, RelativeSource={RelativeSource AncestorType=UserControl}}" IsTextSearchEnabled="False" StaysOpenOnEdit="True" KeyUp="ClassComboBox_KeyUp" Background="Transparent" Foreground="#E0E0E0" BorderThickness="0" Padding="5">
                                    <ComboBox.Resources><Style TargetType="ToggleButton"><Setter Property="Visibility" Value="Collapsed"/></Style></ComboBox.Resources>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Pt." Width="*" CellStyle="{StaticResource NoClipCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <ComboBox IsEditable="True" Text="{Binding FriClass, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.ClassNames, RelativeSource={RelativeSource AncestorType=UserControl}}" IsTextSearchEnabled="False" StaysOpenOnEdit="True" KeyUp="ClassComboBox_KeyUp" Background="Transparent" Foreground="#E0E0E0" BorderThickness="0" Padding="5">
                                    <ComboBox.Resources><Style TargetType="ToggleButton"><Setter Property="Visibility" Value="Collapsed"/></Style></ComboBox.Resources>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>