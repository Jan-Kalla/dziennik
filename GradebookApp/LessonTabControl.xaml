<UserControl x:Class="GradebookApp.LessonTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="#E0E0E0">
    <UserControl.Resources>
        
        <Style TargetType="DataGrid">
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="Cell"/>
        </Style>

        <Style x:Key="CellTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#333337"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCellsPresenter">
            <Setter Property="ClipToBounds" Value="False" />
        </Style>

        <Style x:Key="NoClipCellStyle" TargetType="DataGridCell">
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="GotFocus" Handler="DataGridCell_GotFocus"/> 
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#E0E0E0"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowAddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="ToolTip" Value="Wstaw nowy wiersz"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderAddButtonStyle" TargetType="Button" BasedOn="{StaticResource RowAddButtonStyle}">
            <Setter Property="ToolTip" Value="Wstaw wiersz na samej górze"/>
            <Style.Triggers>
                <!-- Pokazuje przycisk tylko, gdy najeżdżamy myszką na nagłówek -->
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="RowMenu" x:Shared="False" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Szczegóły poprawy" Click="ViewRetakeDetails_Click" FontWeight="Bold">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRetake}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Edytuj poprawę" Click="EditRetake_Click">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRetake}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Usuń ten wiersz" Click="DeleteRow_Click" Foreground="#E53935" FontWeight="Bold"/>
        </ContextMenu>

        <ContextMenu x:Key="RetakeItemMenu">
            <MenuItem Header="Szczegóły poprawy" Click="ViewRetakeItemDetails_Click" FontWeight="Bold"/>
            <MenuItem Header="Edytuj poprawę" Click="EditRetakeItem_Click"/>
            <MenuItem Header="Usuń ten wiersz" Click="DeleteRetakeItem_Click" Foreground="#E53935" FontWeight="Bold"/>
        </ContextMenu>

        <Style x:Key="RowStyleWithMenu" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Panel.ZIndex" Value="9999"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DailyRowStyleWithMenu" TargetType="DataGridRow">
            <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333337"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="MenuItem">
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="MenuItem_BlockRightClick"/>
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="MenuItem_BlockRightClick"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel x:Name="DateNavigationPanel" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Content="◀" Width="32" Height="32" Background="#3E3E42" Foreground="#E0E0E0" BorderThickness="0" Cursor="Hand" Click="PrevDay_Click" ToolTip="Poprzedni dzień" Margin="0,0,10,0" Focusable="False"/>
                <TextBlock x:Name="LessonDateText" Text="Dzisiaj: -" FontSize="20" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center" Width="400" TextAlignment="Center"/>
                <Button Content="▶" Width="32" Height="32" Background="#3E3E42" Foreground="#E0E0E0" BorderThickness="0" Cursor="Hand" Click="NextDay_Click" ToolTip="Następny dzień" Margin="10,0,0,0" Focusable="False"/>
            </StackPanel>

            <StackPanel x:Name="WeeklyHeaderPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="WeeklyTitleText" Text="Rozkład tygodniowy" FontSize="20" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <CheckBox x:Name="HideDutiesCheckBox" Content="Ukryj dyżury" Margin="25,0,0,0" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="14" IsChecked="False" Click="HideDutiesCheckBox_Click" Focusable="False"/>
                <Border Margin="30,0,0,0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Sala na poprawy:" Foreground="#AAAAAA" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="DefaultRoomTextBox" Width="100" Height="26" VerticalContentAlignment="Center" Background="#1E1E1E" Foreground="#E0E0E0" BorderBrush="#555555" Padding="4,1" FontSize="14" LostFocus="DefaultRoomTextBox_LostFocus" ToolTip="Sala lub gabinet na poprawy (np. Sala 102). Będzie widoczna dla uczniów w aplikacji MatApp."/>
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DailyViewBtn" Content="Widok dzienny" Width="140" Height="32" Background="#3E3E42" Foreground="White" BorderThickness="0" Click="DailyViewBtn_Click" Cursor="Hand" FontWeight="Bold" FontSize="15" Focusable="False"/>
                <Button x:Name="WeeklyViewBtn" Content="Widok tygodniowy" Width="160" Height="32" Background="#2D2D30" Foreground="#AAAAAA" BorderThickness="0" Click="WeeklyViewBtn_Click" Cursor="Hand" Margin="5,0,0,0" FontSize="15" Focusable="False"/>
            </StackPanel>
        </Grid>

        <!-- WIDOK DZIENNY -->
        <DataGrid x:Name="DailyScheduleGrid" Grid.Row="1" FontSize="16" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="False" HeadersVisibility="Column" Background="#1E1E1E" Foreground="#E0E0E0" BorderBrush="#3E3E42" GridLinesVisibility="All" RowStyle="{StaticResource DailyRowStyleWithMenu}" PreviewKeyDown="TasksDataGrid_PreviewKeyDown">
            <DataGrid.Columns>
                <!-- Zintegrowana kolumna "Nr" połączona z przyciskami "+" do dodawania wierszy -->
                <DataGridTemplateColumn Width="45" CellStyle="{StaticResource NoClipCellStyle}">
                    <!-- Wymuszamy rozciągnięcie zawartości nagłówka na pełną szerokość -->
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <!-- Narzucenie kolorów z motywu -->
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#E0E0E0"/>
                            <!-- Wyłączenie ucinania brzegów komórki -->
                            <Setter Property="ClipToBounds" Value="False"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Grid ClipToBounds="False" Background="Transparent" Height="30">
                                <TextBlock Text="Nr" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E0E0E0"/>
                                <!-- Poprawiony margines dla plusa na górze -->
                                <Button Content="+" Style="{StaticResource HeaderAddButtonStyle}" Click="AddRowAtTop_Click" Height="20" Width="20" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-8" Panel.ZIndex="100"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid ClipToBounds="False" Background="Transparent" MinHeight="35">
                                <TextBlock Text="{Binding LessonNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888"/>
                                <Button Content="+" Click="AddRowBelow_Click" Height="20" Width="20" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-10" Panel.ZIndex="100">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource RowAddButtonStyle}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRetake}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- KOLUMNA GODZINA (ZABLOKOWANA) Z WYŚRODKOWANIEM -->
                <DataGridTemplateColumn CellStyle="{StaticResource NoClipCellStyle}" Width="120">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#E0E0E0"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="Godz." HorizontalAlignment="Center" FontWeight="Bold" Foreground="#E0E0E0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent" MinHeight="35">
                                <TextBlock Foreground="#E0E0E0" Margin="0,5" Text="{Binding TimeSlot}" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- KOLUMNA KLASA (ZABLOKOWANA) -->
                <DataGridTemplateColumn CellStyle="{StaticResource NoClipCellStyle}" Header="Klasa (dyżur)" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent" MinHeight="35">
                                <TextBlock Text="{Binding ClassName}" Foreground="#E0E0E0" Margin="10,5" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowMultipleClasses}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding RetakeItems}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowMultipleClasses}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="36">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding ClassName}" Foreground="#E0E0E0" Margin="10,5" VerticalAlignment="Center"/>
                                                <Border Grid.Row="1" Height="1" Background="#3E3E42" Visibility="{Binding SeparatorVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- KOLUMNA MATERIAŁ (OPTYMALIZACJA ZAPISU I BLOKADA DLA DYŻURÓW) -->
                <DataGridTemplateColumn CellStyle="{StaticResource NoClipCellStyle}" Header="Zrealizowany materiał" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <!-- Panel zwykłej lekcji -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRetake}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <!-- ZNAK WODNY Z HISTORIĄ -->
                                    <TextBlock FontStyle="Italic" Foreground="#666666" IsHitTestVisible="False" Margin="5,0" Text="{Binding MaterialWatermark}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Material}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Material}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    
                                    <!-- WŁAŚCIWE POLE EDYCJI -->
                                    <TextBox Text="{Binding Material, UpdateSourceTrigger=LostFocus}">
                                        <TextBox.Style>
                                            <Style BasedOn="{StaticResource CellTextBoxStyle}" TargetType="TextBox">
                                                <Setter Property="IsEnabled" Value="True"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LessonNumber}" Value="">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LessonNumber}" Value="{x:Null}">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>

                                <!-- Panel poprawki/poprawek -->
                                <ItemsControl ItemsSource="{Binding RetakeItems}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRetake}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="36" Background="Transparent" ToolTip="{Binding Tooltip}" ContextMenu="{StaticResource RetakeItemMenu}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding Material}" Foreground="#4DB6AC" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0"/>
                                                <Border Grid.Row="1" Height="1" Background="#3E3E42" Visibility="{Binding SeparatorVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- STRZAŁKA PRZEJŚCIA (UKRYTA DLA DYŻURÓW) -->
                <DataGridTemplateColumn CellStyle="{StaticResource NoClipCellStyle}" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <!-- Standardowa lekcja -->
                                <Button Click="GoToLessonInfo_Click" Content="→" Cursor="Hand" Focusable="False" FontSize="18" FontWeight="Bold" Margin="2" ToolTip="Przejdź do okna informacji">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#007ACC"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#005A9E"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding LessonNumber}" Value="">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LessonNumber}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRetake}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Poprawki -->
                                <ItemsControl ItemsSource="{Binding RetakeItems}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRetake}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="36">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Button Grid.Row="0" Click="RetakeItemArrow_Click" Content="→" Cursor="Hand" Focusable="False" FontSize="18" FontWeight="Bold" Margin="2" ToolTip="Szczegóły poprawy">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="#007ACC"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#005A9E"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Border Grid.Row="1" Height="1" Background="#3E3E42" Visibility="{Binding SeparatorVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- WIDOK TYGODNIOWY -->
        <DataGrid x:Name="WeeklyScheduleGrid" Grid.Row="1" FontSize="16" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="False" HeadersVisibility="Column" Background="#1E1E1E" RowBackground="#252526" AlternatingRowBackground="#2D2D30" Foreground="#E0E0E0" BorderBrush="#3E3E42" GridLinesVisibility="All" Visibility="Collapsed" RowStyle="{StaticResource RowStyleWithMenu}" PreviewKeyDown="TasksDataGrid_PreviewKeyDown">
            <DataGrid.Columns>
                <!-- Zintegrowana kolumna "Nr" połączona z przyciskami "+" do dodawania wierszy -->
                <DataGridTemplateColumn Width="45" CellStyle="{StaticResource NoClipCellStyle}">
                    <!-- Wymuszamy rozciągnięcie zawartości nagłówka na pełną szerokość -->
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <!-- Narzucenie kolorów z motywu -->
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#E0E0E0"/>
                            <!-- Wyłączenie ucinania brzegów komórki -->
                            <Setter Property="ClipToBounds" Value="False"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Grid ClipToBounds="False" Background="Transparent" Height="30">
                                <TextBlock Text="Nr" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E0E0E0"/>
                                <!-- Poprawiony margines dla plusa na górze -->
                                <Button Content="+" Style="{StaticResource HeaderAddButtonStyle}" Click="AddRowAtTop_Click" Height="20" Width="20" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-8" Panel.ZIndex="100"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid ClipToBounds="False" Background="Transparent" MinHeight="35">
                                <TextBlock Text="{Binding LessonNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888"/>
                                <Button Content="+" Click="AddRowBelow_Click" Height="20" Width="20" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-10" Panel.ZIndex="100">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource RowAddButtonStyle}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRetake}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="120" CellStyle="{StaticResource NoClipCellStyle}">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#E0E0E0"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
