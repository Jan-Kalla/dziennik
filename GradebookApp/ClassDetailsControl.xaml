<UserControl x:Class="GradebookApp.ClassDetailsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E" Foreground="#E0E0E0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <TextBlock x:Name="ClassNameText" Grid.Column="1" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Odśwież tabelę ↻" Width="110" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshTable_Click" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </Grid>
        
        <TabControl Grid.Row="1" FontSize="14">
            
            <TabItem Header="Lista uczniów">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBox x:Name="SearchTextBox" Grid.Column="0" Margin="0,0,10,0" Height="30" VerticalContentAlignment="Center" 
                                 ToolTip="Wpisz imię, nazwisko lub nazwę pracy..." TextChanged="SearchTextBox_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Szukaj ucznia..." Foreground="#888888" Margin="5,0,0,0" FontStyle="Italic"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        
                        <Button Grid.Column="1" Content="⇄ Zamień Imię z Nazwiskiem" Width="200" Height="30" Click="SwapColumns_Click" Cursor="Hand" Background="#333333" Foreground="#E0E0E0" BorderBrush="#555555" />
                    </Grid>
                             
                    <DataGrid x:Name="StudentsDataGrid" Grid.Row="1" Margin="0,0,0,10" FontSize="16" 
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionUnit="Cell" 
                              RowEditEnding="StudentsDataGrid_RowEditEnding">
                        <!-- Wyłączyliśmy wbudowane, problematyczne dodawanie wierszy w siatce -->
                        
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#007ACC"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>

                            <Style x:Key="FirstNameElementStyle" TargetType="TextBlock">
                                <Setter Property="Padding" Value="5,2,5,2"/>
                            </Style>
                            
                            <Style x:Key="FirstNameEditingStyle" TargetType="TextBox">
                                <Setter Property="Padding" Value="2,0,0,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>

                            <Style x:Key="LastNameElementStyle" TargetType="TextBlock">
                                <Setter Property="Padding" Value="5,2,5,2"/>
                            </Style>
                            
                            <Style x:Key="LastNameEditingStyle" TargetType="TextBox">
                                <Setter Property="Padding" Value="2,0,0,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nr" Binding="{Binding JournalNumber}" Width="50" />
                            <DataGridTextColumn x:Name="FirstNameCol" Header="Imię" Binding="{Binding FirstName}" Width="*" 
                                                ElementStyle="{StaticResource FirstNameElementStyle}" 
                                                EditingElementStyle="{StaticResource FirstNameEditingStyle}" />
                            <DataGridTextColumn x:Name="LastNameCol" Header="Nazwisko" Binding="{Binding LastName}" Width="*" 
                                                ElementStyle="{StaticResource LastNameElementStyle}" 
                                                EditingElementStyle="{StaticResource LastNameEditingStyle}" />
                            <DataGridTextColumn Header="Średnia %" Binding="{Binding AveragePercentage, StringFormat={}{0:0}\%}" Width="100" IsReadOnly="True" />
                            
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Szczegóły" Margin="2,2,2,2" Click="StudentDetailsButton_Click" Cursor="Hand">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Otwórz szczegóły w nowym oknie" Click="OpenStudentNewWindow_Click"/>
                                                    <Separator />
                                                    <MenuItem Header="Usuń ucznia" Click="DeleteStudent_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- NOWY SYSTEM SZYBKIEGO DODAWANIA -->
                    <Border Grid.Row="2" Background="#252526" BorderBrush="#434346" BorderThickness="1" CornerRadius="5" Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Szybkie dodawanie:" Foreground="#4DB6AC" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                            <StackPanel x:Name="FirstNameStackPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                                <TextBlock Text="Imię:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="QuickAddFirstNameTextBox" TabIndex="1" Width="150" Height="28" VerticalContentAlignment="Center" PreviewKeyDown="QuickAdd_PreviewKeyDown"/>
                            </StackPanel>

                            <StackPanel x:Name="LastNameStackPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0">
                                <TextBlock Text="Nazwisko:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="QuickAddLastNameTextBox" TabIndex="2" Width="150" Height="28" VerticalContentAlignment="Center" PreviewKeyDown="QuickAdd_PreviewKeyDown"/>
                            </StackPanel>

                            <Button Grid.Column="3" Content="Dodaj (Enter)" TabIndex="3" Width="120" Height="28" Click="QuickAddStudent_Click" Background="#2E4A2E" BorderBrush="#4CAF50" Foreground="White" Cursor="Hand" Margin="20,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            
            <TabItem Header="Oceny">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <DataGrid x:Name="WorksDataGrid" Grid.Row="0" Margin="0,0,0,10" FontSize="16" 
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kategoria" Binding="{Binding WorkType}" Width="120" />
                            <DataGridTextColumn Header="Tytuł oceny" Binding="{Binding Title}" Width="*" />
                            
                            <DataGridTextColumn Header="Max pkt" Binding="{Binding MaxFinalPoints}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn Header="Napisano" Binding="{Binding DateWrittenDisplay}" Width="110" />
                            <DataGridTextColumn Header="Wpisano" Binding="{Binding DateEnteredDisplay}" Width="110" />
                            
                            <DataGridTextColumn Header="Oceniono" Binding="{Binding AttendanceRatio}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#4DB6AC"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Wyniki" Margin="2,2,5,2" Width="Auto" Padding="5,2" Click="WorkResultsButton_Click" Cursor="Hand" Background="#1E2E1E" BorderBrush="#4CAF50"/>
                                            <Button Content="Szczegóły" Margin="2,2,2,2" Width="Auto" Padding="5,2" Click="WorkDetailsButton_Click" Cursor="Hand">
                                                <Button.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="Usuń ocenę" Click="DeleteWork_Click"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="1" Content="Dodaj nową ocenę" Width="150" Height="35" HorizontalAlignment="Center" Click="AddWork_Click"/>
                </Grid>
            </TabItem>
            
            <TabItem Header="Kalendarz">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <CheckBox x:Name="ShowAllWorksCheckBox" Grid.Row="0" Content="Pokaż wszystkie prace (również pierwsze terminy)" Margin="0,0,0,15" FontSize="14" Checked="RefreshCalendar_Click" Unchecked="RefreshCalendar_Click" />
                    
                    <DataGrid x:Name="CalendarDataGrid" Grid.Row="1" Margin="0,0,0,10" FontSize="16" 
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Edytuj poprawę" Click="EditRetake_Click"/>
                                <MenuItem Header="Usuń poprawę" Click="DeleteRetake_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding DateDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Godz." Binding="{Binding TimeDisplay}" Width="70"/>
                            <DataGridTextColumn Header="Forma" Binding="{Binding WorkType}" Width="120"/>
                            <DataGridTextColumn Header="Tytuł" Binding="{Binding Title}" Width="*"/>
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Szczegóły" Margin="2" Click="ViewRetakeDetails_Click" Cursor="Hand">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Edytuj" Click="EditRetake_Click"/>
                                                    <MenuItem Header="Usuń" Click="DeleteRetake_Click" Foreground="#E57373" FontWeight="Bold"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2" Content="Zaplanuj poprawę" Width="150" Height="35" HorizontalAlignment="Center" Click="PlanRetake_Click"/>
                </Grid>
            </TabItem>
            
        </TabControl>
    </Grid>
</UserControl>