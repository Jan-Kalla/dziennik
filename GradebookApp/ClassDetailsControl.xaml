<UserControl x:Class="GradebookApp.ClassDetailsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E" Foreground="#E0E0E0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <!-- NAGŁÓWEK Z PRZYCISKIEM ODŚWIEŻ -->
        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <TextBlock x:Name="ClassNameText" Grid.Column="1" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Odśwież tabelę ↻" Width="110" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshTable_Click" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </Grid>
        
        <TabControl Grid.Row="1" FontSize="14">
            
            <TabItem Header="Lista uczniów">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <TextBox x:Name="SearchTextBox" Grid.Row="0" Margin="0,0,0,10" Height="30" VerticalContentAlignment="Center" 
                             ToolTip="Wpisz imię, nazwisko lub nazwę pracy..." TextChanged="SearchTextBox_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Szukaj ucznia..." Foreground="#888888" Margin="5,0,0,0" FontStyle="Italic"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                             
                    <DataGrid x:Name="StudentsDataGrid" Grid.Row="1" Margin="0,0,0,10" FontSize="16" 
                              AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="False"
                              SelectionUnit="Cell" 
                              InitializingNewItem="StudentsDataGrid_InitializingNewItem"
                              RowEditEnding="StudentsDataGrid_RowEditEnding">
                        
                        <DataGrid.Resources>
                            <!-- Podmiana systemowych kolorów zaznaczenia komórek na tryb ciemny -->
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#007ACC"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>

                            <Style x:Key="FirstNameElementStyle" TargetType="TextBlock">
                                <Setter Property="Padding" Value="5,2,5,2"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="wpisz imię..." Foreground="#888888" FontStyle="Italic"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            
                            <Style x:Key="FirstNameEditingStyle" TargetType="TextBox">
                                <Setter Property="Padding" Value="2,0,0,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="wpisz imię..." Foreground="#888888" FontStyle="Italic"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="LastNameElementStyle" TargetType="TextBlock">
                                <Setter Property="Padding" Value="5,2,5,2"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="wpisz nazwisko..." Foreground="#888888" FontStyle="Italic"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            
                            <Style x:Key="LastNameEditingStyle" TargetType="TextBox">
                                <Setter Property="Padding" Value="2,0,0,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="wpisz nazwisko..." Foreground="#888888" FontStyle="Italic"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsNewItem" Value="True">
                                        <Setter Property="Background" Value="#252526" />
                                        <Setter Property="ToolTip" Value="Kliknij w komórkę, aby dodać nowego ucznia w tym wierszu" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nr" Binding="{Binding JournalNumber}" Width="50" />
                            <DataGridTextColumn Header="Imię" Binding="{Binding FirstName}" Width="*" 
                                                ElementStyle="{StaticResource FirstNameElementStyle}" 
                                                EditingElementStyle="{StaticResource FirstNameEditingStyle}" />
                            <DataGridTextColumn Header="Nazwisko" Binding="{Binding LastName}" Width="*" 
                                                ElementStyle="{StaticResource LastNameElementStyle}" 
                                                EditingElementStyle="{StaticResource LastNameEditingStyle}" />
                            <DataGridTextColumn Header="Średnia %" Binding="{Binding AveragePercentage, StringFormat={}{0:0}\%}" Width="100" IsReadOnly="True" />
                            
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Szczegóły" Margin="2,2,2,2" Click="StudentDetailsButton_Click" Cursor="Hand">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Otwórz szczegóły w nowym oknie" Click="OpenStudentNewWindow_Click"/>
                                                    <Separator />
                                                    <MenuItem Header="Usuń ucznia" Click="DeleteStudent_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Id}" Value="0">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2" Content="Dodaj ucznia" Width="120" Height="35" HorizontalAlignment="Center" Click="AddStudent_Click"/>
                </Grid>
            </TabItem>
            
            <TabItem Header="Prace pisemne">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <DataGrid x:Name="WorksDataGrid" Grid.Row="0" Margin="0,0,0,10" FontSize="16" 
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <!-- Usunięto ID i Liczbę zadań. Dodano Frekwencję i podpięto właściwe zmienne z ViewModelu -->
                            <DataGridTextColumn Header="Rodzaj" Binding="{Binding WorkType}" Width="120" />
                            <DataGridTextColumn Header="Tytuł" Binding="{Binding Title}" Width="*" />
                            
                            <DataGridTextColumn Header="M (Max pkt)" Binding="{Binding MaxFinalPoints}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn Header="Napisano" Binding="{Binding DateWrittenDisplay}" Width="110" />
                            <DataGridTextColumn Header="Wpisano" Binding="{Binding DateEnteredDisplay}" Width="110" />
                            
                            <DataGridTextColumn Header="Napisane przez" Binding="{Binding AttendanceRatio}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#4DB6AC"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- Przyciski z automatyczną szerokością -->
                                            <Button Content="Wyniki" Margin="2,2,5,2" Width="Auto" Padding="5,2" Click="WorkResultsButton_Click" Cursor="Hand" Background="#1E2E1E" BorderBrush="#4CAF50"/>
                                            <Button Content="Szczegóły" Margin="2,2,2,2" Width="Auto" Padding="5,2" Click="WorkDetailsButton_Click" Cursor="Hand">
                                                <Button.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="Usuń pracę" Click="DeleteWork_Click"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="1" Content="Dodaj nową pracę" Width="150" Height="35" HorizontalAlignment="Center" Click="AddWork_Click"/>
                </Grid>
            </TabItem>
            
        </TabControl>
    </Grid>
</UserControl>