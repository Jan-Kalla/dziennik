<Window x:Class="GradebookApp.TemplateManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Menedżer Szablonów" SizeToContent="Height" Width="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="#E0E0E0">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Zarządzanie szablonami" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="#E0E0E0"/>
        
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBox x:Name="SearchTemplateTextBox" Height="30" Margin="0,0,10,0" VerticalContentAlignment="Center" FontSize="14" TextChanged="SearchTemplateTextBox_TextChanged">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="Szukaj szablonu po nazwie..." Foreground="#888888" Margin="5,0,0,0" FontStyle="Italic"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            
            <Button Grid.Column="1" Content="Dodaj nowy szablon" Width="140" Height="30" Click="AddNewTemplate_Click" Background="#2E4A2E" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </Grid>
        
        <ListBox x:Name="TemplatesListBox" Grid.Row="2" Height="120" Margin="0,0,0,15" SelectionChanged="TemplatesListBox_SelectionChanged" FontSize="15" Cursor="Hand" DisplayMemberPath="Title" BorderBrush="#333" Background="#252526" Foreground="#E0E0E0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,5"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <Border Grid.Row="3" BorderBrush="#434346" BorderThickness="0,1,0,0" Margin="0,0,0,15"/>

        <TextBlock x:Name="FormTitleTextBlock" Grid.Row="4" Text="Nowy szablon:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#4DB6AC"/>

        <Grid Grid.Row="5" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Kategoria oceny:" Margin="0,0,0,5" FontSize="14"/>
                <ComboBox x:Name="WorkTypeComboBox" Height="28" FontSize="14" SelectionChanged="WorkTypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="kartkówka" IsSelected="True"/>
                    <ComboBoxItem Content="sprawdzian"/>
                    <ComboBoxItem Content="aktywność"/>
                    <ComboBoxItem Content="inne"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="MaxPointsLabel" Text="Max:" Margin="0,0,0,5" FontSize="14" FontWeight="Bold" Foreground="#4DB6AC"/>
                <TextBox x:Name="MaxPointsTextBox" Height="28" FontSize="14" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Tytuł pracy pisemnej:" Grid.Row="6" Margin="0,0,0,5" FontSize="14"/>
        <TextBox x:Name="TitleTextBox" Grid.Row="7" Height="28" Margin="0,0,0,15" FontSize="14" VerticalContentAlignment="Center"/>

        <CheckBox x:Name="ApplyToAllCheckBox" Content="Zastosuj ustawienia do wszystkich grup" IsChecked="True" Grid.Row="8" FontSize="13" Foreground="#4DB6AC" FontWeight="Bold" Margin="0,0,0,15" Checked="ApplyToAllCheckBox_Changed" Unchecked="ApplyToAllCheckBox_Changed"/>

        <Border x:Name="GroupManagementPanel" Grid.Row="9" Margin="0,0,0,15" Background="#2D2D30" Padding="10" CornerRadius="5">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ComboBox x:Name="GroupsComboBox" Width="50" Height="28" FontSize="14" Margin="0,0,10,0" SelectionChanged="GroupsComboBox_SelectionChanged"/>
                    <Button Content="Usuń" Width="50" Height="28" Click="RemoveGroup_Click" Cursor="Hand" Margin="0,0,20,0"/>

                    <TextBlock Text="Dodaj grupę:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0" Foreground="#FFB74D"/>
                    <TextBox x:Name="NewGroupNameTextBox" Width="35" Height="28" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,10,0"/>
                    <Button Content="Dodaj" Width="60" Height="28" Click="AddGroup_Click" Cursor="Hand"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Liczba zadań:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0" Foreground="#FFB74D"/>
                    <TextBox x:Name="TaskCountTextBox" Width="40" Height="28" VerticalContentAlignment="Center" FontSize="14" TextChanged="TaskCountTextBox_TextChanged"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid x:Name="TasksDataGrid" Grid.Row="10" Margin="0,0,0,15" FontSize="14" MinHeight="150" MaxHeight="250"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="Cell"
                  PreviewKeyDown="TasksDataGrid_PreviewKeyDown">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Zad." Binding="{Binding TaskNumber}" IsReadOnly="True" Width="45">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Poz I" Binding="{Binding L1, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="55" />
                <DataGridTextColumn Header="Poz II" Binding="{Binding L2, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="55" />
                <DataGridTextColumn Header="Poz III" Binding="{Binding L3, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="55" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="11" Margin="0,10,0,0">
            <Button x:Name="DeleteButton" Content="Usuń szablon" HorizontalAlignment="Left" Width="100" Height="30" Click="Delete_Click" Background="#E57373" Foreground="#1E1E1E" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- NOWY PRZYCISK: Klonowanie szablonu -->
                <Button x:Name="SaveAsCopyButton" Content="Zapisz jako kopię" Width="130" Height="30" Margin="0,0,10,0" Click="SaveAsCopy_Click" Visibility="Collapsed" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Zamknij" Width="80" Height="30" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Content="Zapisz" Width="100" Height="30" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>