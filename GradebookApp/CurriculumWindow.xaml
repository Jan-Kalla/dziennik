<Window x:Class="GradebookApp.CurriculumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rozkład materiału" Height="600" Width="650" 
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#E0E0E0">
    
    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#333337" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#4DB6AC" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2D2D30" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#4DB6AC" />

        <HierarchicalDataTemplate x:Key="CurriculumTemplate" ItemsSource="{Binding Children}">
            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="→ " Foreground="#888888" FontSize="16" VerticalAlignment="Center"/>
                
                <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="16" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,15,0" MouseLeftButtonUp="TopicTextBlock_MouseLeftButtonUp">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="0">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#4DB6AC"/>
                                </DataTrigger>
                                <!-- Kursor zmienia się w łapkę, podpowiadając, że temat można kliknąć -->
                                <DataTrigger Binding="{Binding IsTopic}" Value="True">
                                    <Setter Property="Cursor" Value="Hand"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- NOWY KONTENER NA WIELE PLIKÓW -->
                <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" Margin="0,2,0,2">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTopic}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    
                    <!-- ZADANIA -->
                    <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding TaskRowVisibility}">
                        <TextBlock Text="Zadania:" Width="65" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="12"/>
                        <ItemsControl ItemsSource="{Binding TaskFiles}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding FileName}" CommandParameter="{Binding}" Click="FileButton_Click" Background="#2E4A2E" Foreground="#E0E0E0" BorderThickness="0" Padding="8,2" Margin="0,0,5,0" Cursor="Hand" ToolTip="Otwórz plik (lub usuń w trybie edycji)"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+" CommandParameter="Task" Tag="{Binding Id}" Click="AddPdfButton_Click" Background="#3E3E42" Foreground="#E0E0E0" BorderThickness="0" Width="20" Height="20" Cursor="Hand" ToolTip="Dodaj nowy plik zadań" Visibility="{Binding EditModeVisibility}"/>
                    </StackPanel>
                    
                    <!-- ODPOWIEDZI -->
                    <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding AnswerRowVisibility}">
                        <TextBlock Text="Odp:" Width="65" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="12"/>
                        <ItemsControl ItemsSource="{Binding AnswerFiles}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding FileName}" CommandParameter="{Binding}" Click="FileButton_Click" Background="#2E4A2E" Foreground="#E0E0E0" BorderThickness="0" Padding="8,2" Margin="0,0,5,0" Cursor="Hand" ToolTip="Otwórz plik (lub usuń w trybie edycji)"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+" CommandParameter="Answer" Tag="{Binding Id}" Click="AddPdfButton_Click" Background="#3E3E42" Foreground="#E0E0E0" BorderThickness="0" Width="20" Height="20" Cursor="Hand" ToolTip="Dodaj nowy plik odpowiedzi" Visibility="{Binding EditModeVisibility}"/>
                    </StackPanel>

                    <!-- KARTKÓWKI -->
                    <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="{Binding QuizRowVisibility}">
                        <TextBlock Text="Kartkówki:" Width="65" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="12"/>
                        <ItemsControl ItemsSource="{Binding QuizFiles}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding FileName}" CommandParameter="{Binding}" Click="FileButton_Click" Background="#4A2E2E" Foreground="#E0E0E0" BorderThickness="0" Padding="8,2" Margin="0,0,5,0" Cursor="Hand" ToolTip="Otwórz plik (lub usuń w trybie edycji)"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+" CommandParameter="Quiz" Tag="{Binding Id}" Click="AddPdfButton_Click" Background="#3E3E42" Foreground="#E0E0E0" BorderThickness="0" Width="20" Height="20" Cursor="Hand" ToolTip="Dodaj nowy plik kartkówki" Visibility="{Binding EditModeVisibility}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Rozkład materiału" FontSize="20" FontWeight="Bold" Foreground="#4DB6AC" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" Padding="10">
            <TreeView x:Name="CurriculumTreeView" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource CurriculumTemplate}" SelectedItemChanged="CurriculumTreeView_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True"/>
                        <Setter Property="Padding" Value="5,2"/>
                        <Setter Property="Margin" Value="0,2"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </Border>

        <!-- PANEL EDYCJI -->
        <Border x:Name="EditPanel" Grid.Row="2" Background="#2D2D30" BorderBrush="#434346" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,15,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Nazwa:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="EditNameTextBox" Width="250" Height="26" VerticalContentAlignment="Center" Background="#1E1E1E" Foreground="White" BorderThickness="0" Padding="5,0"/>
                    
                    <TextBlock Text="Godz:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <TextBox x:Name="EditHoursTextBox" Width="40" Height="26" VerticalContentAlignment="Center" Background="#1E1E1E" Foreground="White" BorderThickness="0" Padding="5,0" ToolTip="Puste = brak godzin"/>
                    
                    <Button Content="Zapisz nazwę/godz" Margin="15,0,0,0" Width="130" Height="26" Background="#2E4A2E" Foreground="White" BorderThickness="0" Cursor="Hand" Click="SaveNodeEdit_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="+ Dział" Width="70" Height="26" Margin="0,0,5,0" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" Click="AddRoot_Click" ToolTip="Dodaj nowy główny Dział"/>
                    <Button x:Name="AddChildBtn" Content="+ Podrzędny" Width="90" Height="26" Margin="0,0,5,0" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" Click="AddChild_Click" ToolTip="Dodaj element wewnątrz wybranego (np. Rozdział do Działu)"/>
                    <Button x:Name="AddSiblingBtn" Content="+ Obok" Width="70" Height="26" Margin="0,0,20,0" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" Click="AddSibling_Click" ToolTip="Dodaj element na tym samym poziomie"/>
                    <Button x:Name="DeleteNodeBtn" Content="Usuń wybrany" Width="100" Height="26" Background="#A13B3B" Foreground="White" BorderThickness="0" Cursor="Hand" Click="DeleteNode_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Button x:Name="EditToggleBtn" Grid.Row="3" Content="Edytuj" HorizontalAlignment="Right" Width="150" Height="30" Margin="0,15,0,0" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" Click="ToggleEditMode_Click"/>
    </Grid>
</Window>