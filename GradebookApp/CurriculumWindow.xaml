<Window x:Class="GradebookApp.CurriculumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rozkład materiału" Height="500" Width="600" 
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#E0E0E0">
    
    <Window.Resources>
        <!-- Styl usuwający podświetlenie zaznaczenia w drzewku -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E0E0E0" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E0E0E0" />

        <HierarchicalDataTemplate x:Key="CurriculumTemplate" ItemsSource="{Binding Children}">
            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Strzałka zagnieżdżenia wg Twojego szkicu -->
                <TextBlock Grid.Column="0" Text="→ " Foreground="#888888" FontSize="16" VerticalAlignment="Center"/>
                
                <!-- Nazwa elementu (np. Dział 1) oraz liczba godzin w nawiasie -->
                <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="16" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <!-- Wyróżnienie Działów pogrubieniem -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="0">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#4DB6AC"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 3 przyciski PDF wg szkicu (widoczne tylko dla Tematów) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTopic}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    
                    <Button Content="→" Width="22" Height="22" Margin="0,0,4,0" ToolTip="Zadania (PDF)" Click="PdfButton_Click" Background="#3E3E42" Foreground="#E0E0E0" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="→" Width="22" Height="22" Margin="0,0,4,0" ToolTip="Odpowiedzi (PDF)" Click="PdfButton_Click" Background="#3E3E42" Foreground="#E0E0E0" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="→" Width="22" Height="22" Margin="0,0,10,0" ToolTip="Kartkówki (PDF)" Click="PdfButton_Click" Background="#4A2E2E" Foreground="#E0E0E0" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Rozkład materiału" FontSize="20" FontWeight="Bold" Foreground="#4DB6AC" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" Padding="10">
            <TreeView x:Name="CurriculumTreeView" 
                      Background="Transparent" 
                      BorderThickness="0"
                      ItemTemplate="{StaticResource CurriculumTemplate}">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <!-- Rozwiń wszystko domyślnie -->
                        <Setter Property="IsExpanded" Value="True"/>
                        <!-- Zmiana marginesów, by wcięcia były widoczne, ale nie za duże -->
                        <Setter Property="Padding" Value="5,2"/>
                        <Setter Property="Margin" Value="0,2"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </Border>

        <!-- Przycisk Edytuj w prawym dolnym rogu (Tworzenie rozkładu) -->
        <Button Grid.Row="2" Content="Edytuj" HorizontalAlignment="Right" Width="100" Height="30" Margin="0,15,0,0" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" Click="EditCurriculum_Click"/>
    </Grid>
</Window>