<Window x:Class="GradebookApp.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statystyki Popraw" Height="720" Width="1080" WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#E0E0E0"
        Icon="icon2.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Analiza Skuteczności Popraw" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>
        
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Klasa:" VerticalAlignment="Center" FontSize="16" Margin="0,0,10,0"/>
            <ComboBox x:Name="ClassComboBox" Grid.Column="1" Height="30" FontSize="16" SelectionChanged="ClassComboBox_SelectionChanged" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            
            <TextBlock Text="Praca pisemna:" Grid.Column="2" VerticalAlignment="Center" FontSize="16" Margin="20,0,10,0"/>
            <ComboBox x:Name="WorkComboBox" Grid.Column="3" Height="30" FontSize="16" SelectionChanged="WorkComboBox_SelectionChanged" DisplayMemberPath="Title" SelectedValuePath="Id"/>
        </Grid>
        
        <Border Grid.Row="2" Background="#2D2D30" CornerRadius="5" Padding="20">
            <StackPanel>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="TotalRetakesText" Text="Liczba poprawionych prac: -" FontSize="18" FontWeight="Bold" Margin="0,0,0,0" Foreground="#4CAF50" VerticalAlignment="Center"/>
                    
                    <TextBlock Grid.Column="2" Text="Widok tabeli:" FontSize="14" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="DisplayModeComboBox" Grid.Column="3" Height="28" FontSize="14" SelectedIndex="2" SelectionChanged="DisplayModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Tylko liczba"/>
                        <ComboBoxItem Content="Tylko procent"/>
                        <ComboBoxItem Content="Liczba i procent"/>
                    </ComboBox>
                </Grid>
                
                <!-- NOWOCZESNA TABELA ROZDZIELCZA -->
                <Border Margin="0,15,0,25" BorderBrush="#434346" BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- NAGŁÓWKI (Tło: #252526 - Lekko odcinające się od tła okna) -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#252526" BorderBrush="#434346" BorderThickness="0,0,1,1" CornerRadius="5,0,0,0"/>
                        <Border Grid.Row="0" Grid.Column="1" Background="#252526" BorderBrush="#434346" BorderThickness="0,0,1,1" Padding="15,12"><TextBlock Text="Udane" FontSize="15" FontWeight="Bold" Foreground="#E0E0E0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Row="0" Grid.Column="2" Background="#252526" BorderBrush="#434346" BorderThickness="0,0,1,1" Padding="15,12"><TextBlock Text="Nieudane" FontSize="15" FontWeight="Bold" Foreground="#E0E0E0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Row="0" Grid.Column="3" Background="#252526" BorderBrush="#434346" BorderThickness="0,0,0,1" Padding="15,12" CornerRadius="0,5,0,0"><TextBlock Text="Łącznie" FontSize="15" FontWeight="Bold" Foreground="#E0E0E0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        
                        <!-- WIERSZ 1: Poprawy z jedynek (Tło: #1E1E1E - Najciemniejsze, "wklęsłe") -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#1E1E1E" BorderBrush="#434346" BorderThickness="0,0,1,1" Padding="15,12"><TextBlock Text="Z oceny niedostatecznej (1)" FontSize="15" Foreground="#CCCCCC" HorizontalAlignment="Right" VerticalAlignment="Center"/></Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="#1E1E1E" BorderBrush="#434346" BorderThickness="0,0,1,1" Padding="15,12"><TextBlock x:Name="SuccessFrom1Text" Text="- (-%)" FontSize="16" Foreground="#4CAF50" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Row="1" Grid.Column="2" Background="#1E1E1E" BorderBrush="#434346" BorderThickness="0,0,1,1" Padding="15,12"><TextBlock x:Name="FailFrom1Text" Text="- (-%)" FontSize="16" Foreground="#E53935" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Row="1" Grid.Column="3" Background="#1E1E1E" BorderBrush="#434346" BorderThickness="0,0,0,1" Padding="15,12"><TextBlock x:Name="TotalFrom1Text" Text="-" FontSize="16" Foreground="#E0E0E0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        
                        <!-- WIERSZ 2: Poprawy z 2+ -->
                        <Border Grid.Row="2" Grid.Column="0" Background="#1E1E1E" BorderBrush="#434346" BorderThickness="0,0,1,1" Padding="15,12"><TextBlock Text="Z oceny dopuszczającej i wyższej (2+)" FontSize="15" Foreground="#CCCCCC" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Right"/></Border>
                        <Border Grid.Row="2" Grid.Column="1" Background="#1E1E1E" BorderBrush="#434346" BorderThickness="0,0,1,1" Padding="15,12"><TextBlock x:Name="SuccessFrom2Text" Text="- (-%)" FontSize="16" Foreground="#4CAF50" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Row="2" Grid.Column="2" Background="#1E1E1E" BorderBrush="#434346" BorderThickness="0,0,1,1" Padding="15,12"><TextBlock x:Name="FailFrom2Text" Text="- (-%)" FontSize="16" Foreground="#E53935" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Row="2" Grid.Column="3" Background="#1E1E1E" BorderBrush="#434346" BorderThickness="0,0,0,1" Padding="15,12"><TextBlock x:Name="TotalFrom2Text" Text="-" FontSize="16" Foreground="#E0E0E0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>

                        <!-- WIERSZ 3: PODSUMOWANIE (Tło: #252526 - Wizualna klamra) -->
                        <Border Grid.Row="3" Grid.Column="0" Background="#252526" BorderBrush="#434346" BorderThickness="0,0,1,0" Padding="15,12" CornerRadius="0,0,0,5"><TextBlock Text="Łącznie" FontSize="15" FontWeight="Bold" Foreground="#E0E0E0" HorizontalAlignment="Right" VerticalAlignment="Center"/></Border>
                        <Border Grid.Row="3" Grid.Column="1" Background="#252526" BorderBrush="#434346" BorderThickness="0,0,1,0" Padding="15,12"><TextBlock x:Name="TotalSuccessText" Text="- (-%)" FontSize="16" Foreground="#4CAF50" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Row="3" Grid.Column="2" Background="#252526" BorderBrush="#434346" BorderThickness="0,0,1,0" Padding="15,12"><TextBlock x:Name="TotalFailText" Text="- (-%)" FontSize="16" Foreground="#E53935" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Border Grid.Row="3" Grid.Column="3" Background="#252526" Padding="15,12" CornerRadius="0,0,5,0"><TextBlock x:Name="GrandTotalText" Text="-" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Border>
                
                <Separator Background="#444444" Margin="0,0,0,15"/>
                
                <TextBlock Text="Faktyczne zmiany wyników:" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                <CheckBox x:Name="IncludeFailedCheckBox" Content="Uwzględniaj zera (wliczaj nieudane poprawy do średniej przyrostu)" Foreground="#AAAAAA" Margin="0,0,0,5" Checked="OptionsCheckBox_Changed" Unchecked="OptionsCheckBox_Changed"/>
                <CheckBox x:Name="IncludeStillFailedCheckBox" Content="Uwzględniaj poprawy częściowo udane (wliczaj poprawy z 1 na 1 do średniej przyrostu)" Foreground="#AAAAAA" Margin="0,0,0,10" Checked="OptionsCheckBox_Changed" Unchecked="OptionsCheckBox_Changed"/>
                
                <TextBlock x:Name="AvgGainText" Text="Średni całkowity przyrost: - p.p." FontSize="18" Foreground="#007ACC" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock x:Name="AvgGain1Text" Text="• w grupie ocen niedostatecznych (1): - p.p." FontSize="14" Foreground="#888888" Margin="10,0,0,2"/>
                <TextBlock x:Name="AvgGain2Text" Text="• w grupie ocen pozytywnych (2+): - p.p." FontSize="14" Foreground="#888888" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>