<Window x:Class="GradebookApp.WorkEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="470" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="#E0E0E0">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Kategoria oceny:" Margin="0,0,0,5" FontSize="14"/>
        <ComboBox x:Name="WorkTypeComboBox" Grid.Row="1" Height="28" Margin="0,0,0,10" FontSize="14" SelectionChanged="WorkTypeComboBox_SelectionChanged">
            <ComboBoxItem Content="kartkówka" IsSelected="True"/>
            <ComboBoxItem Content="sprawdzian"/>
            <ComboBoxItem Content="aktywność"/>
            <ComboBoxItem Content="inne"/>
        </ComboBox>

        <TextBlock Text="Tytuł oceny:" Grid.Row="2" Margin="0,0,0,5" FontSize="14"/>
        <TextBox x:Name="TitleTextBox" Grid.Row="3" Height="28" Margin="0,0,0,10" FontSize="14" VerticalContentAlignment="Center"/>

        <TextBlock x:Name="MaxPointsLabel" Text="Max:" Grid.Row="4" Margin="0,0,0,5" FontSize="14" FontWeight="Bold" Foreground="#4DB6AC"/>
        <TextBox x:Name="MaxPointsTextBox" Grid.Row="5" Height="28" Margin="0,0,0,15" FontSize="14" VerticalContentAlignment="Center"/>

        <!-- Sekcja z datami -->
        <Grid x:Name="DatesPanel" Grid.Row="6" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Data napisania:" Margin="0,0,0,5" FontSize="14"/>
                <DatePicker x:Name="DateWrittenPicker" Height="28" FontSize="14"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Data wpisania (opcj.):" Margin="0,0,0,5" FontSize="14"/>
                <DatePicker x:Name="DateEnteredPicker" Height="28" FontSize="14"/>
            </StackPanel>
        </Grid>

        <CheckBox x:Name="ApplyToAllCheckBox" Content="Zastosuj ustawienia do wszystkich grup" IsChecked="True" Grid.Row="7" FontSize="13" Foreground="#4DB6AC" FontWeight="Bold" Margin="0,0,0,15" Checked="ApplyToAllCheckBox_Changed" Unchecked="ApplyToAllCheckBox_Changed"/>

        <Border x:Name="GroupManagementPanel" Grid.Row="8" Margin="0,0,0,15" Background="#2D2D30" Padding="10" CornerRadius="5">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ComboBox x:Name="GroupsComboBox" Width="50" Height="28" FontSize="14" Margin="0,0,10,0" SelectionChanged="GroupsComboBox_SelectionChanged"/>
                    <Button Content="Usuń" Width="50" Height="28" Click="RemoveGroup_Click" Cursor="Hand" Margin="0,0,20,0"/>

                    <TextBlock Text="Dodaj grupę:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0" Foreground="#FFB74D"/>
                    <TextBox x:Name="NewGroupNameTextBox" Width="35" Height="28" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,10,0"/>
                    <Button Content="Dodaj" Width="60" Height="28" Click="AddGroup_Click" Cursor="Hand"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Liczba zadań:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0" Foreground="#FFB74D"/>
                    <TextBox x:Name="TaskCountTextBox" Width="40" Height="28" VerticalContentAlignment="Center" FontSize="14" TextChanged="TaskCountTextBox_TextChanged"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid x:Name="TasksDataGrid" Grid.Row="9" Margin="0,0,0,15" FontSize="14" MinHeight="150" MaxHeight="300"
                AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="Cell"
                PreviewKeyDown="TasksDataGrid_PreviewKeyDown">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Zad." Binding="{Binding TaskNumber}" IsReadOnly="True" Width="45">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Poz I" Binding="{Binding L1, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="55" />
                <DataGridTextColumn Header="Poz II" Binding="{Binding L2, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="55" />
                <DataGridTextColumn Header="Poz III" Binding="{Binding L3, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="55" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Ostrzeżenie przy edycji -->
        <TextBlock x:Name="EditWarningText" Grid.Row="10" Text="Uwaga: Zmiana ilości punktów lub struktury zadań spowoduje usunięcie dotychczas wpisanych ocen uczniów u których wykryto konflikt." Foreground="#E57373" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10" FontSize="12" FontStyle="Italic"/>

        <!-- Dolny pasek z nowym przyciskiem -->
        <Grid Grid.Row="11" Margin="0,10,0,0">
            <Button x:Name="UseTemplateButton" Content="Użyj szablonu" HorizontalAlignment="Left" Width="120" Height="30" Click="UseTemplate_Click" Background="#333333" Foreground="#4DB6AC" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Anuluj" Width="80" Height="30" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Content="Zapisz" Width="100" Height="30" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>